<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.pragmatica.temper</groupId>
        <artifactId>temper-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>temper-controller</artifactId>
    <name>temper controller</name>

    <dependencies>
        <dependency>
            <groupId>org.pragmatica.temper</groupId>
            <artifactId>temper-test-support</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.pragmatica.temper</groupId>
            <artifactId>github-app-auth</artifactId>
        </dependency>
        <dependency>
            <groupId>org.pragmatica.temper</groupId>
            <artifactId>temper-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>org.pragmatica.temper</groupId>
            <artifactId>temper-protocol</artifactId>
        </dependency>
        <dependency>
            <groupId>org.pragmatica.temper</groupId>
            <artifactId>temper-store</artifactId>
        </dependency>
        <dependency>
            <groupId>org.pragmatica-lite</groupId>
            <artifactId>core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.pragmatica-lite</groupId>
            <artifactId>toml</artifactId>
        </dependency>
        <dependency>
            <groupId>org.pragmatica-lite</groupId>
            <artifactId>jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.pragmatica-lite</groupId>
            <artifactId>http-server</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- Only the version file is filtered (m0-design §12.7 item 3): the expected worker version is the build's
                 own ${project.version}, never hand-typed, and the judge its ${temper.judge} (m2-design §1.7). -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>org/pragmatica/temper/controller/controller-version.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>org/pragmatica/temper/controller/controller-version.properties</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- it-pg tier (m0-design §9): the *IT classes need docker for postgres:16 and run in the
                         default build; without docker they are skipped, never passed. -->
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                    <systemPropertyVariables>
                        <project.version>${project.version}</project.version>
                        <temper.judge>${temper.judge}</temper.judge>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <configuration>
                            <excludes>
                                <exclude>**/DirectStartOrderingTest.java</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <!-- Verification F1 (R-13): the direct start's ordering depends on virtual-thread scheduling, which
                         is deterministic only with ONE carrier (a 1-vCPU runner). This fork pins it there. -->
                    <execution>
                        <id>one-carrier</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <test>DirectStartOrderingTest,StartFailureLivenessTest#directStart*</test>
                            <argLine>-Djdk.virtualThreadScheduler.parallelism=1</argLine>
                            <reportsDirectory>${project.build.directory}/surefire-reports-one-carrier</reportsDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!-- Attached as `-all` (the deployed, runnable jar), never replacing the main jar: the main
                                 jar stays this module's classes only, so a module that depends on it (temper-acceptance)
                                 gets temper-domain and the others from their own jars, not shaded copies that shadow
                                 them by classpath order (M1 WP7 verification, F5). -->
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>all</shadedClassifierName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.pragmatica.temper.controller.Main</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
