<configuration>
    <!-- The controller runs under systemd: one line per event on stderr, collected by the journal. -->
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSX,UTC} %-5level %logger{30} - %msg%n</pattern>
        </encoder>
    </appender>
    <logger name="io.netty" level="WARN"/>
    <logger name="org.pragmatica.postgres" level="WARN"/>
    <root level="INFO">
        <appender-ref ref="STDERR"/>
    </root>
</configuration>
