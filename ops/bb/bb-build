    fi
    rm -f "$f"
  done
  NOPASS=""; [ -z "$REJ" ] || { LF=${LF:+$LF$'\n'}fields_rejected=${REJ:0:256}; NOPASS=1; }
  if [ -n "${BB_LAUNCH:-}" ] && ! grep -q '^verdict_source=' <<< "$LF"; then LF=${LF:+$LF$'\n'}verdict_source=missing; NOPASS=1; fi
  WRC=$BRC; [ -z "$NOPASS" ] || [ "$BRC" != 0 ] || WRC=18   # never a pass (header: LAUNCH FIELDS); a non-zero rc is kept as it is
  [ -z "${BB_TEST_BEFORE_LOCK:-}" ] || bash -c "$BB_TEST_BEFORE_LOCK" || true   # TEST SEAM (inert unless set): runs in the window between the fields read and the lock (BbRcTicketRecordIT)
  exec 8> "$Q/.lock"; flock 8
  [ -f "$T" ] || exit 0   # cancel or reap already finalized this ticket (first writer wins): do not recreate running/<id> or overwrite done/<id>
  # CTO 2026-11-21: under the lock, just before the append, the run ticket must still be ours; a launch whose marker changed since the read copies nothing (a process the job left behind can still rewrite its OWN fields in that window, within the grammar: accepted)
  if [ -n "${BB_LAUNCH:-}" ] && [ "$HT" = "$ID" ] && [ "$(run_ticket "$CO" 2> /dev/null | head -c 128 | head -n 1)" != "$ID" ]; then LF="fields_rejected=ticket_changed"$'\n'"verdict_source=missing"; [ "$BRC" != 0 ] || WRC=18; fi
  { [ -z "$LF" ] || printf '%s\n' "$LF"; printf 'oom_kill_end=%s\nmem_avail_kb_end=%s\nstate=finished\nrc=%s\nended=%s\n' "$OOM_END" "$MEM_END" "$WRC" "$(cat "$B/end" 2>/dev/null || date +%s)"; } >> "$T"
  to_done "$T"
  exit 0
fi

SINCE=""
if [ "${1:-}" = --since ]; then
  [ -n "${2:-}" ] && [ -n "${3:-}" ] || { echo "refusing: --since needs <base> and a checkout" >&2; exit 2; }
  [[ $2 =~ ^[A-Za-z0-9._/~^@{}-]{1,200}$ ]] && [[ $2 != -* ]] || { echo "refusing: --since base must be a git ref (^[A-Za-z0-9._/~^@{}-]{1,200}\$, not starting with -)" >&2; exit 2; }
  SINCE=$2; shift 2
fi
CO=$(cd "$1" && pwd); shift
# Ownership guard (2026-09-27, after a cross-agent build into another agent's checkout):
# every caller declares BB_OWNER (its agent prefix, e.g. s5, v1552); a checkout belongs to the
# owner whose "<owner>-" prefix its directory name carries. No match -> refuse, before any write.
: "${BB_OWNER:?refusing: set BB_OWNER=<your agent prefix>; checkout names must start with <prefix>-}"
case "$BB_OWNER" in *[!A-Za-z0-9_]*|"") echo "refusing: BB_OWNER must be [A-Za-z0-9_]+" >&2; exit 4;; esac
case "$(basename "$CO")" in "$BB_OWNER"-*) ;; *) echo "refusing: $CO is not owned by BB_OWNER=$BB_OWNER (name must start with $BB_OWNER-)" >&2; exit 4;; esac
[ $# -gt 0 ] || set -- clean install
MODS=""; SINCE_REASON=""
if [ -n "$SINCE" ]; then
  [ -f "$(dirname "$SELF")/bb-modules.py" ] || { echo "refusing: --since needs bb-modules.py next to bb-build" >&2; exit 2; }
  case " $* " in *" -pl "*|*" --projects"*|*" -pl"[!\ ]*|*" -am "*|*" -amd "*|*" -f "*|*" --file"*) echo "refusing: --since expands to its own -pl; the args already select modules" >&2; exit 2;; esac
  SEL=$(python3 "$(dirname "$SELF")/bb-modules.py" "$CO" "$SINCE") || { echo "refusing: bb-modules.py failed for base $SINCE in $CO" >&2; exit 2; }
  case $SEL in
    NONE) echo "bb-build: nothing changed since $SINCE; nothing queued"; exit 0;;
    FULL|"FULL "*) MODS=FULL; SINCE_REASON=$(printf '%s' "${SEL#FULL}" | tr -c 'A-Za-z0-9._/:@+-' '?'); SINCE_REASON=${SINCE_REASON#\?}
       echo "bb-build: --since $SINCE -> FULL reactor (${SINCE_REASON:-no reason given})";;
    *) MODS=$(printf '%s' "$SEL" | tr ',' '\n' | wc -l | tr -d ' '); MODS=$((MODS + 1)); set -- -pl "$SEL" "$@"
       echo "bb-build: --since $SINCE -> -pl $SEL ($MODS modules)";;
  esac
fi
case "${BB_REQUIRE_DOCKER:-1}" in 0|1) ;; *) echo "refusing: BB_REQUIRE_DOCKER must be 0 or 1 (or unset)" >&2; exit 2;; esac
refuse_repeated_test_goal "$@"   # #132: rc 2, nothing queued, before the first write
MUTANT_FIELDS=""   # header: MUTANT TICKETS
if [ -n "${BB_ORDER_AT+x}" ]; then
  [[ $BB_ORDER_AT =~ ^[1-9][0-9]{18}$ ]] || { echo "refusing: BB_ORDER_AT must be epoch nanoseconds (19 digits)" >&2; exit 2; }
  [[ ! $BB_ORDER_AT > $(date +%s%N) ]] || { echo "refusing: BB_ORDER_AT $BB_ORDER_AT is in the future" >&2; exit 2; }   # 19 digits on both sides: string order is number order, and a value above 2^63 is compared too
  [[ ${BB_VIA:-} =~ ^bb-mutate:[A-Za-z0-9._-]{1,20}:[A-Za-z0-9._-]+$ && ${#BB_VIA} -le 64 ]] || { echo "refusing: BB_ORDER_AT is accepted only from bb-mutate (BB_VIA is not a bb-mutate marker)" >&2; exit 2; }
  [[ ${BB_MUTANT_BOUND:-} =~ ^[1-9][0-9]{0,5}$ ]] || { echo "refusing: BB_ORDER_AT needs BB_MUTANT_BOUND (seconds, 1 to 6 digits)" >&2; exit 2; }
  [[ ${BB_DRIVER_PID:-} =~ ^[1-9][0-9]{0,9}$ && ${BB_DRIVER_START:-} =~ ^[1-9][0-9]{0,18}$ ]] && mutate_driver "$BB_DRIVER_PID" "$BB_DRIVER_START" \
    || { echo "refusing: BB_ORDER_AT is accepted only from bb-mutate (BB_DRIVER_PID/BB_DRIVER_START name no running bb-mutate above this call)" >&2; exit 2; }
  [ "$BB_ORDER_AT" -ge "$(start_ns "$BB_DRIVER_START")" ] || { echo "refusing: BB_ORDER_AT $BB_ORDER_AT is before the start of its driver" >&2; exit 2; }
  MUTANT_FIELDS=$(printf 'order_at=%s\ndriver_pid=%s\ndriver_start=%s\nbound=%s' "$BB_ORDER_AT" "$BB_DRIVER_PID" "$BB_DRIVER_START" "$BB_MUTANT_BOUND")$'\n'
fi
unset BB_ORDER_AT BB_DRIVER_PID BB_DRIVER_START BB_MUTANT_BOUND   # also without BB_ORDER_AT: a stray BB_DRIVER_* or BB_MUTANT_BOUND must not reach the waiter or maven
B=$CO/.bb; mkdir -p "$B"
if [ ! -f "$B/rc" ] && [ -f "$B/start" ]; then
  # .bb/start without .bb/rc: a build still running, or a finished build whose .bb/rc a lane deleted (CTO 2026-11-13: three verifier
  # lanes rm'd it to "reset" a checkout). Name the second case: no waiting/running ticket for this checkout and the done/ ticket named by .bb/ticket (#80; was: whose started= is this .bb/start), state=finished and a numeric rc= (its build wrote .bb/rc; an orphaned or cancelled run may never have).
  # Anything else (e.g. a BB_QUEUE=0 build, which has no ticket) keeps the running message. One direct done/<ticket> lookup: done/ holds tens
  # of thousands of tickets, so no scan (v50a: a field() fork per file took ~2 min on bigboy).
  TK=$(run_ticket "$CO" || true)   # unknown (no .bb/ticket) leaves TK empty: the plain message below
  LIVE=""; FIN=""
  for f in "$Q"/waiting/* "$Q"/running/*; do [ -f "$f" ] && [ "$(field "$f" co)" = "$CO" ] && LIVE=${f##*/}; done
  if [ -z "$LIVE" ] && [ -n "$TK" ] && [ -f "$Q/done/$TK" ]; then   # #80: .bb/ticket names the run that owns .bb; none (pre-#80 run) = no guess
    f=$Q/done/$TK
    [ "$(field "$f" co)" = "$CO" ] && [ "$(field "$f" state)" = finished ] && [[ $(field "$f" rc) =~ ^[0-9]+$ ]] && FIN=$TK
  fi
  [ -z "$FIN" ] || { echo "refusing: .bb/rc in $CO was deleted by hand after ticket $FIN finished; never rm it (its verdict is the ticket record: bb-wait $FIN); rerun bb-build in a fresh checkout (a rerun in a checkout whose .bb/rc is intact clears it itself)" >&2; exit 3; }
  echo "refusing: a build appears to be running in $CO (.bb/start without .bb/rc)" >&2; exit 3
fi
# The guards below match the args with a here-string, never `printf | grep -q`: grep exits at its first match, printf then dies of SIGPIPE on a
# long arg list, and under pipefail that status turns a MATCH into "no match" (#102; a guard would silently not fire).
# Host-killing test guard (2026-09-27, #1553): StreamPublishReshuffleTest leaks sockets without bound and
# exhausted this host's ephemeral ports twice. Unless this checkout's copy carries the #1553 @Disabled, refuse
# any invocation that names it or that selects Heavy forge tests without explicitly excluding it.
SPRT="$CO/aether/forge/forge-tests/src/test/java/org/pragmatica/aether/forge/StreamPublishReshuffleTest.java"
if [ -f "$SPRT" ] && ! grep -q '@Disabled("#1553' "$SPRT"; then
  ARGS=" $* "
  if grep -Eq '[^!]StreamPublishReshuffleTest' <<< "$ARGS"; then
    echo "refusing: this run names StreamPublishReshuffleTest (#1553 host-killing leak; see runbook 0c)" >&2; exit 6; fi
  # the exclusion must sit in -Dit.test: forge-tests runs through failsafe, which ignores -Dtest (2026-09-29)
  if grep -Eq 'groups=[^ ]*Heavy|excludedGroups= |-Pwith-e2e' <<< "$ARGS" && ! grep -Eq -- ' -Dit\.test=[^ ]*!StreamPublishReshuffleTest' <<< "$ARGS"; then
    echo "refusing: Heavy/e2e forge selection without '-Dit.test=…,!StreamPublishReshuffleTest' (#1553; see runbook 0c; -Dtest does not reach failsafe)" >&2; exit 6; fi
fi
# Failsafe filter guard (2026-09-29, s3's forge run at 36b5c3d42): forge-tests skips surefire and runs every test through
# failsafe, which reads -Dit.test and IGNORES -Dtest. A run that names forge-tests (-pl or -f), reaches integration-test,
# and filters with -Dtest but not -Dit.test would run the whole IT suite. Refuse (rc 10); BB_IT_UNFILTERED=1 overrides.
A=" $* "
if [ "${BB_IT_UNFILTERED:-0}" != 1 ] && grep -Eq -- ' (-pl|--projects|-f|--file)[= ]?[^ ]*forge-tests' <<< "$A" \
   && grep -Eq -- ' -Dtest=' <<< "$A" && ! grep -Eq -- ' -Dit\.test=' <<< "$A" \
   && grep -Eq ' (integration-test|verify|install|deploy) ' <<< "$A"; then
  echo "refusing: forge-tests runs through failsafe, which ignores -Dtest; filter with -Dit.test=… (BB_IT_UNFILTERED=1 to run the whole IT suite)" >&2; exit 10
fi
# Uninstalled sibling (#112): see the header. Fails open: any answer but MISSING (OK, SKIP, a crashed helper) goes on.
if [ -z "$SINCE" ] && [ -f "$(dirname "$SELF")/bb-modules.py" ] && grep -Eq -- ' (-pl|--projects)' <<< "$A"; then
  CHK=$(python3 "$(dirname "$SELF")/bb-modules.py" --installed "$CO" "$@" 2>/dev/null) || CHK="SKIP the check itself failed"
  case "$CHK" in
    MISSING*) echo "refusing (rc 11): -pl without -am; reactor modules it depends on are not installed: ${CHK#MISSING }; add -am, or install them first (nothing queued)" >&2; exit 11;;
    SKIP*) echo "bb-build: -pl check skipped: ${CHK#SKIP }" >&2;;
  esac
fi
# Concurrency cap (2026-09-27): above 3 concurrent reactors, fixed-port tests collide (BindException)
# and Testcontainers fails to start, so results are environmental noise. The queue grants a ticket only while
# fewer than CAP queue launches (the LEDGER: what this queue started, maven or bb-test's java alike) run, and never more than the host cap (~/work/max-reactors, #56). Override the cap only with BB_MAX_REACTORS. BB_CAP_WAIT_SECS > 0 bounds the
# queue wait (then .bb/rc = 5); unset = wait until granted.
CAP=${BB_MAX_REACTORS:-5}; LIMIT=${BB_CAP_WAIT_SECS:-0}
case "$CAP$LIMIT" in *[!0-9]*) echo "refusing: BB_MAX_REACTORS / BB_CAP_WAIT_SECS must be non-negative integers" >&2; exit 2;; esac
# cap=1 is for ROOT builds only (2026-09-29): a module build (-pl/-f) with BB_MAX_REACTORS=1 would wait for an EMPTY host
# and, before backfill, blocked every ticket behind it. Warn and use the default cap.
if [ "$CAP" = 1 ] && grep -Eq -- ' (-pl|--projects|-f|--file)([= ]|[^ ]*/)' <<< " $* "; then
  echo "WARNING: BB_MAX_REACTORS=1 is for root builds only; this is a module build (-pl/-f), so the default cap 5 is used" >&2
  CAP=5
fi

# Dedup key: HEAD + maven.config (minus the per-checkout repo.local line) + args. Only for a CLEAN tree: a dirty
# tree (a mutation probe, local edits) is the same SHA with different content, so it is never deduped.
case "${BB_PORT_GROUP:-}" in
  1|0) GROUP="$BB_PORT_GROUP forced by BB_PORT_GROUP=$BB_PORT_GROUP";;
  "") GROUP=$(python3 "$(dirname "$SELF")/bb-portgroup.py" "$PGM" "$CO" "$@" 2>/dev/null) || GROUP="1 classifier failed"
      case "$GROUP" in [01]\ *) ;; *) GROUP="1 classifier gave no answer";; esac;;
  *) echo "refusing: BB_PORT_GROUP must be 0, 1 or unset" >&2; exit 2;;
esac

SHA=$(git -C "$CO" rev-parse HEAD)
KEY=""
if [ -z "$(git -C "$CO" status --porcelain --untracked-files=normal)" ]; then
  KEY=$( { printf '%s\n' "$SHA"; grep -v '^-Dmaven.repo.local=' "$CO/.mvn/maven.config" 2>/dev/null; printf '%s\0' "$@"; [ "${BB_REQUIRE_DOCKER:-1}" = 1 ] || printf 'requireDocker=0\0'; } | sha256sum | cut -c1-16)
else
  echo "dedup: skipped (working tree has changes vs $SHA)"
fi

# A bb-mutate call (BB_VIA bb-mutate:*) has NO dedup key: it is never deduped, and nothing dedups onto its ticket (key= is written empty; the two
# dedup loops below skip an empty key). Its control is a clean-tree build, and a plain identical build deduped onto it would get no result when its
# driver dies (the waiting ticket is dropped, .bb/rc 9; N4 of the #117 review). The only readers of key= are those two loops.
case ${BB_VIA:-} in bb-mutate:*) KEY="";; esac
exec 8> "$Q/.lock"; flock 8
reap >/dev/null   # its stdout is the launch count, for pick only (#90)
QD=$(cat "$B/queued" 2>/dev/null || true)
if [ -n "$QD" ] && [ -f "$Q/waiting/$QD" ]; then echo "refusing: $CO already has queued ticket $QD" >&2; exit 3; fi
if [ -n "$KEY" ] && [ "${BB_DEDUP:-1}" != 0 ]; then
  for f in "$Q"/running/* "$Q"/waiting/*; do
    [ -f "$f" ] && [ "$(field "$f" key)" = "$KEY" ] || continue
    echo "dedup: identical build is $(basename "${f%/*}"): ticket=${f##*/} owner=$(field "$f" owner)" >&2
    echo "dedup: read its result at $(field "$f" co)/.bb (poll for rc); BB_DEDUP=0 to run anyway" >&2; exit 7
  done
  for f in $(ls -t "$Q"/done/ 2>/dev/null); do
    f=$Q/done/$f
    [ "$(field "$f" key)" = "$KEY" ] && [ "$(field "$f" state)" = finished ] || continue
    o=$(field "$f" co)
    [ -f "$o/.bb/rc" ] && run_current "$o" "${f##*/}" || continue   # since rebuilt/removed: not current, and unknown (no .bb/ticket, a pre-#80 run) counts as not current (#80)
    echo "dedup: identical build already finished: rc=$(field "$f" rc) ended=$(date -d @"$(field "$f" ended)" -Is) owner=$(field "$f" owner)" >&2
    echo "dedup: read its result at $o/.bb (bb-report $o); BB_DEDUP=0 to run anyway" >&2; exit 8
  done
fi

# Ticket owner fields (T3): each optional, each validated; a bad value is dropped with a notice and never blocks the build.
OWNER_FIELDS=""
[ -z "$SINCE" ] || OWNER_FIELDS+="since=$SINCE"$'\n'"modules=$MODS"$'\n'
[ -z "$SINCE_REASON" ] || OWNER_FIELDS+="since_reason=$SINCE_REASON"$'\n'
ownerval() {  # ownerval <BB_NAME> <regex> -> value on stdout when set and valid; notice on stderr when set and malformed
  local v=${!1:-}
  [ -n "$v" ] || return 1
  [[ $v =~ $2 ]] && { printf '%s' "$v"; return 0; }
  echo "bb-build: ignoring $1: not $2" >&2; return 1
}
LABEL_RE='^[A-Za-z0-9._:-]{1,64}$'; WORD_RE='^[A-Za-z0-9._-]{1,64}$'
SP=$(ownerval BB_SESSION_PID '^[1-9][0-9]{0,9}$') || SP=""
SS=$(ownerval BB_SESSION_START '^[1-9][0-9]{8,10}$') || SS=""
SL=$(ownerval BB_SESSION_LABEL "$LABEL_RE") || SL=""
if [ -n "$SP" ] && [ -n "$SS" ] && [ -n "$SL" ]; then
  OWNER_FIELDS+=$(printf 'session_pid=%s\nsession_start=%s\nsession_label=%s\n' "$SP" "$SS" "$SL")$'\n'
elif [ -n "${BB_SESSION_PID:-}${BB_SESSION_START:-}${BB_SESSION_LABEL:-}" ]; then
  echo "bb-build: ignoring BB_SESSION_PID/BB_SESSION_START/BB_SESSION_LABEL: need all three, each valid" >&2
fi
AG=$(ownerval BB_AGENT "$WORD_RE") && OWNER_FIELDS+="agent=$AG"$'\n'
LN=$(ownerval BB_LANE "$WORD_RE") && OWNER_FIELDS+="lane=$LN"$'\n'
PRN=$(ownerval BB_PR '^[1-9][0-9]{0,9}$') && OWNER_FIELDS+="pr=$PRN"$'\n'
VIA=$(ownerval BB_VIA "$LABEL_RE") && OWNER_FIELDS+="via=$VIA"$'\n'   # who submitted: bb-mutate sets bb-mutate:<spec>:<mutant> (issue #46); additive
OWNER_FIELDS+="output=$B/build.log"$'\n'
[ "${BB_REQUIRE_DOCKER:-1}" = 1 ] || OWNER_FIELDS+="requireDocker=0"$'\n'
[ -z "${BB_LAUNCH:-}" ] || OWNER_FIELDS+="requireDockerEffective=$([ "${BB_REQUIRE_DOCKER:-1}" = 1 ] && echo true || echo false)"$'\n'   # bb-test tickets only (CTO 2026-11-19): a count without Testcontainers must never read as a full one
[ -z "$DETACHED_READER" ] || OWNER_FIELDS+="detached_reader=$DETACHED_READER"$'\n'

ID=$(date +%s%N)-$$
T=$Q/waiting/$ID
rm -f "$B/rc" "$B/end" "$B/start" "$B/ticket"
echo "bb-build: queued ticket $ID at $(date -Is); maven has not started (bb-queue shows position)" > "$B/build.log"
echo "$ID" > "$B/queued"
{ printf 'id=%s\nowner=%s\nco=%s\nsha=%s\nkey=%s\ncap=%s\nlimit=%s\ncreated=%s\n' \
    "$ID" "$BB_OWNER" "$CO" "$SHA" "$KEY" "$CAP" "$LIMIT" "$(date +%s%N)"
  printf 'group=%s\ngroup_reason=%s\n' "${GROUP%% *}" "${GROUP#* }"
  [ "${GROUP%% *}" = 1 ] && [ "${BB_PG_ISOLATE:-1}" != 0 ] && command -v docker > /dev/null && printf 'iso=1\n'
  printf '%s%s' "$OWNER_FIELDS" "$MUTANT_FIELDS"
  printf 'args='; printf '%q ' "$@"; printf '\n'; } > "$T"
setsid nohup bash "$SELF" __run "$ID" "$@" < /dev/null > /dev/null 2>&1 8>&- &
for _ in $(seq 50); do waiter_alive "$ID" && break; sleep 0.1; done
waiter_alive "$ID" || { rm -f "$T" "$B/queued"; echo "error: waiter for $ID did not start" >&2; exit 1; }
POS=$(order | grep -nx -- "$ID" | cut -d: -f1 || true)
echo "queued ticket=$ID position=$POS priority=$(prio "$BB_OWNER" "$SHA") reactors=$(reactors) cap=$CAP port-group=${GROUP%% *} (${GROUP#* }) port-group-holders=[$(group_holder)] slots=$(pg_slots) log=$B/build.log args: $*"
