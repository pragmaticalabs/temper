#!/usr/bin/env bash
# bb-build <checkout-dir> [mvn args...]  (default args: clean install)
# QUEUED since 2026-09-28: after the guards below, the build is DEDUPED against identical builds, then ENQUEUED and
# this command returns at once; a detached waiter launches maven when its ticket is granted (priority order from
# ~/work/priorities, FIFO among equals, under the reactor cap). Poll for .bb/rc exactly as before.
# Writes in <checkout>/.bb/: queued (ticket id, while waiting), run.marker (at launch), ticket (the granted run's ticket id, written with start), build.log, start/end
# epochs, rc (a 444 convenience copy of maven's exit code, written INSIDE the job; 5 = queue wait expired, 9 = cancelled/abandoned
# before maven started). Call rc: 0 queued; 2 usage; 3 already running/queued here; 4 owner; 6 #1553 guard;
# 7 identical build running/queued elsewhere; 8 identical build already finished (paths printed); 10 -Dtest without
# -Dit.test on forge-tests (failsafe ignores -Dtest). BB_DEDUP=0
# skips dedup. DEDUP IDENTITY (#80, 2026-11-21): a finished identical build is still the checkout's result only while .bb/ticket names ITS ticket (not while
# .bb/start equals its started=: two runs granted in one second shared a start, and dedup answered with the newer run's result). A checkout with no
# .bb/ticket (run before this change) is not current: no dedup, the safe direction. BB_QUEUE=0 runs the pre-queue script (bb-build-direct) -- it also bypasses the port group -- after removing .bb/ticket (that run writes .bb/start only, so an older ticket must not stay current).
# PORT GROUP (2026-09-29): a run that will execute tests of a fixed-port module (~/work/port-group-modules; decided by
# bb-portgroup.py from the checkout's own poms and the args) is granted only while no other port-group run is running.
# BB_PORT_GROUP=1 forces membership, BB_PORT_GROUP=0 forces exclusion.
# REQUIRE DOCKER (2026-11-12): both maven launches below end with -Daether.requireDocker=true, after the caller's args (pragmatica #2591: a Docker IT
# class FAILS instead of silently not running when Docker is absent; temper ignores the property). Override point (#31, 2026-11-12):
# BB_REQUIRE_DOCKER=0 at enqueue omits the flag from both launches, for a run that must see how a guard behaves WITHOUT it (pragmatica #3090);
# the value is ^[01]$ (anything else: refused, exit 2, nothing queued), unset or 1 = the flag as above. A 0 ticket carries the line
# requireDocker=0 (bb-tickets shows it, bb-queue marks the row [no-requireDocker]) and a 0 build is never deduped against a guarded one.
# ISOLATED SLOTS (2026-11-11): a group ticket's maven runs inside its own docker network namespace (bb-netns-run: host userland
# mounted read-only, checkout and $HOME at the same paths, own loopback), so identical fixed ports cannot collide and up to N
# (~/work/port-group-slots, default 3) group tickets run at once per host, each holding a slot (bb-queue shows it). No change to the
# tests. BB_PG_ISOLATE=0 at enqueue = the old host-exclusive behaviour for that ticket (ticket has no iso=1).
# LOAD GATE (2026-11-11): a ticket is also granted only while load5/cores < 1.2 (BB_LOAD_MAX); the oldest grantable ticket goes
# once it waited > 1200 s (BB_LOAD_STARVE_SECS) while < 2 queue launches run (BB_LOAD_STARVE_REACTORS). MEMORY FLOOR (#53): a grant also
# needs MemAvailable >= the per-host floor; the oldest ticket overrides it only while no ticket runs at all. pick() in the lib decides.
# HOST CAP (#56): a grant also needs live queue launches (the lib's LAUNCH LEDGER, never a process pattern) < min(this ticket's cap, the host's ~/work/max-reactors, default 3); nothing overrides it.
# Off-queue JVMs (#56): the memory floor is compared against MemAvailable minus their unclaimed heap, max(0, Xmx - RSS) each.
# VERDICT SOURCE (2026-11-12, bbrc1; reap and too-late cancel fixed 2026-11-13): the ticket's rc= is the exit status of the build subshell
# as returned by `wait` in the waiter, never a read of .bb/rc. A ticket whose waiter is gone (reap, or a cancel that finds the build
# already ended) is finalized as orphaned with NO rc: bb-wait exits 70, and .bb/rc is not read into it. .bb/rc is a read-only (444) copy
# written before the ticket is finalized, replaced only by rm/rename (write_rc in the lib), never by `>`.
# GUARANTEE: the verdict comes from mvn's exit status, never from the checkout; any later disagreement in the checkout is detected (RC-MISMATCH, exit 71); deliberate tampering with queue/done by the same uid stays possible.
# BB-TEST (2026-11, bb-test lane): a GREEN build then runs bb-cp-record (offline test-compile + dependency:build-classpath; writes .bb/cp/<module>.cp and
# .bb/cp/manifest for bb-test's stale-jar guard); its failure is logged and never changes rc, and it is bounded by BB_CP_RECORD_TIMEOUT seconds
# (default 300; on timeout: "cp-record skipped: timeout" in the log, any record removed, write_rc delayed by at most the bound + 10 s). BB_LAUNCH=<cmd> makes the waiter run <cmd> instead of maven
# (bb-test's own __launch mode); such a ticket sets BB_NO_CP_RECORD=1 and BB_DEDUP=0.
# LAUNCH FIELDS (#76, CTO ruling 2026-11-21): every job gets BB_TICKET=<its id> (bb-netns-run passes it into the container); bb-test's __launch
# never sees the queue and writes its ticket fields to .bb/fields.<id>. That file is UNTRUSTED (test code can write the checkout). Once the
# job has exited, the waiter reads it (before the queue lock: a regular file, not a symlink, at most 64 KiB, under a 10 s timeout) and
# appends, under the queue lock in the same append as (just before) state=finished/rc=, ONLY lines of this grammar (C locale, byte counts):
#   verdict_source=guard | verdict_source=java     (nothing else)
#   refused=<v>   v: 1..1024 bytes, no control byte (so no CR/LF/NUL injection), first byte not '='
# Every other line is rejected by its key (malformed: no <[A-Za-z0-9_]{1,32}>= key), and so is the whole file when the ticket is not a
# BB_LAUNCH one (not_launch), it names another id (foreign_file), it is not regular (not_regular), it cannot be read (unreadable) or
# .bb/ticket does not read <id> (ticket_mismatch). Rejections are recorded as one fields_rejected=<token>[,<token>...] line (at most 256
# bytes; details in build.log). A BB_LAUNCH ticket with no accepted verdict_source gets verdict_source=missing (a crash, OOM or kill
# before bb-test wrote it). A rejection or a missing verdict is never a pass: a job rc of 0 is then recorded as rc=18; a non-zero rc is
# kept. .bb/rc stays the job's own exit status. Every .bb/fields.* is removed at the grant and after the read.
# Every ticket reaching done/ appends one line to ~/work/bb-ticket-log.tsv. `bb-wait <ticket>` blocks until it finishes (exit = rc).
# TICKET OWNER FIELDS (T3, 2026-11): the ticket gains optional key=value lines after group_reason= and before args= (readers
# take the LAST line of a key, so every existing reader ignores them): session_pid, session_start (epoch s) and session_label
# from BB_SESSION_PID / BB_SESSION_START / BB_SESSION_LABEL (all three or none), agent, lane, pr from BB_AGENT, BB_LANE, BB_PR,
# output (always <checkout>/.bb/build.log) and detached_reader from `bb-build --detached --reader <label> <checkout> [args]`
# (those three words first, in that order; refused with rc 2 under BB_QUEUE=0 or without --reader; the flag is not part of the
# maven args or the dedup key). A malformed value never blocks a build: "bb-build: ignoring BB_<NAME>: not <regex>" on stderr,
# the field is omitted. Old callers set none of these.
# INCREMENTAL (2026-11-19, design docs/bb-build-once-design.md §1): `bb-build [--detached --reader L] --since <base> <checkout> [goals]` asks
# bb-modules.py (next to this file) for the module set S = am(C u amd(C)) of the paths changed since <base> (git diff <base>...HEAD, dirty
# tracked and untracked files), prints it, and runs the goals with an explicit `-pl S` (no -am/-amd: the closure already covers the whole
# set, so no upstream resolves from a stale .m2-local jar). FULL (root/parent pom, .mvn/, unmapped path, unparsable pom; the cause goes on the since_reason= ticket line) keeps the whole
# reactor; NONE (no change at all) prints "nothing changed", queues nothing and exits 0. The ticket gains since=<base> and modules=<n|FULL>
# right after group_reason= (same optional-line rule as the owner fields). The dedup key hashes the EXPANDED args. Refused (rc 2): a missing
# or unreadable base, a missing bb-modules.py, or caller args that already carry -pl/-am/-amd/-f (two selections of the modules).
# JBCT BOOTSTRAP (2026-11-19, feat/bb-jbct-bootstrap): a run that asks for a jbct:* goal, an org.pragmatica-lite:jbct-maven-plugin:* goal or the jbct
# profile, in a checkout whose .m2-local lacks the jbct-maven-plugin jar of its effective version (the root pom's plugin entry), first runs CI's bootstrap
# (`mvn install -B -DskipTests -pl <ci.yml list at HEAD> -am`) inside the same ticket, same cap and port group, before the main maven
# (bb-jbct-bootstrap holds the rules and its exit codes: failure -> the ticket's rc is the bootstrap's and the main maven does not run;
# 82-87 are refusals; 88 = the helper itself is missing or not executable on a jbct run, refused before any maven). build.log carries `bootstrap: jbct plugin <ver> installed into .m2-local|present|FAILED rc=<n>`; the ticket carries
# jbct_bootstrap=<ver> after an install. The jbct-run test lives here (wants_jbct) and only here; any other run never execs or even looks for the helper and is unchanged. Not part of the dedup key.
set -euo pipefail
SELF=$(readlink -f "$0")
# --help / -h as the only argument: print this header (the usage and the rules above) to stdout, exit 0, touch nothing
if [ "$#" -eq 1 ] && { [ "$1" = --help ] || [ "$1" = -h ]; }; then sed -n '2,/^set -/{/^set -/!s/^# \{0,1\}//p;}' "$SELF"; exit 0; fi
wants_jbct() {  # the ONE copy of the jbct-run test (the helper trusts it): a jbct:* or org.pragmatica-lite:jbct-maven-plugin:* goal, or the jbct profile (-Pjbct, -P a,jbct, --activate-profiles); "!jbct" / "-jbct" do not count
  local a prof=0 p w=1
  for a in "$@"; do
    if [ "$prof" = 1 ]; then prof=0; a="-P$a"; fi
    case $a in
      jbct:*|org.pragmatica-lite:jbct-maven-plugin:*) w=0 ;;
      -P|--activate-profiles) prof=1 ;;
      -P*|--activate-profiles=*) for p in $(printf '%s' "${a#-P}" | sed 's/^--activate-profiles=//' | tr ',' ' '); do [ "$p" != jbct ] || w=0; done ;;
    esac
  done
  return $w
}
DETACHED_READER=""
if [ "${1:-}" = --detached ]; then
  [ "${BB_QUEUE:-1}" != 0 ] || { echo "refusing: --detached needs the queue" >&2; exit 2; }
  [ "${2:-}" = --reader ] && [ -n "${3:-}" ] || { echo "refusing: --detached needs --reader <label> right after it" >&2; exit 2; }
  [[ $3 =~ ^[A-Za-z0-9._:-]{1,64}$ ]] || { echo "refusing: --reader label must match ^[A-Za-z0-9._:-]{1,64}\$" >&2; exit 2; }
  DETACHED_READER=$3; shift 3
fi
if [ "${1:-}" != __run ] && [ "${BB_QUEUE:-1}" = 0 ]; then
  # the legacy run rewrites .bb/start but never .bb/ticket: drop the ticket first, so an older queued run stops being "current" (#80; none = unknown, the safe direction)
  B=${1:-}; [ "$B" != --since ] || B=${3:-}; B=${B%/}/.bb
  [ ! -d "$B" ] || rm -f "$B/ticket"
  exec "$(dirname "$SELF")/bb-build-direct" "$@"
fi
. "$(dirname "$SELF")/bb-queue-lib.sh"
MVN=${BB_LAUNCH:-${BB_TEST_MVN:-$HOME/tools/maven/bin/mvn}}   # BB_LAUNCH: bb-test enqueues a ticket whose job is its own __launch mode, not maven

if [ "${1:-}" = __run ]; then
  # ---- waiter: one detached process per ticket; becomes the maven job wrapper when granted ----
  set +e
  ID=$2; shift 2
  exec 8> "$Q/.lock"
  T=$Q/waiting/$ID; CO=$(field "$T" co); CAP=$(field "$T" cap); LIMIT=$(field "$T" limit); B=$CO/.bb
  WAITED=0
  while :; do
    flock 8
    [ -f "$T" ] || exit 0   # cancelled or reaped while we slept
    reap
    if [ "$(pick "$ID")" = "$ID" ]; then break; fi   # backfill + starvation bound, see pick() in bb-queue-lib.sh
    if [ "$LIMIT" -gt 0 ] && [ "$WAITED" -ge "$LIMIT" ]; then
      never_started "$CO" 5 "queue wait expired after ${WAITED}s (BB_CAP_WAIT_SECS=$LIMIT)"
      printf 'state=expired\nended=%s\n' "$(date +%s)" >> "$T"; to_done "$T"; exit 0
    fi
    flock -u 8; sleep 5; WAITED=$((WAITED + 5))
  done
  # granted (lock held): launch, record the launch in the LEDGER (the next grant counts it from that line), release the lock at once
  NOW=$(date +%s)
  rm -f "$B/queued" "$B/rc" "$B/end" "$B/refused" "$B"/fields.*; touch "$B/run.marker"; echo "$NOW" > "$B/start"; echo "$ID" > "$B/ticket"; printf '%q ' "$@" > "$B/args"   # for bb-report's EMPTY RUN check
  RDF=(-Daether.requireDocker=true); [ "$(field "$T" requireDocker)" != 0 ] || RDF=()   # #31: the ticket's own record decides
  SLOT=""; [ "$(field "$T" iso)" = 1 ] && SLOT=$(pg_free_slot)
  printf 'started=%s\nwaited=%s\n' "$NOW" "$WAITED" >> "$T"; [ -z "$SLOT" ] || printf 'group_slot=%s\n' "$SLOT" >> "$T"; mv "$T" "$Q/running/$ID"; T=$Q/running/$ID
  # GRANT + LEDGER ATOMIC (vbt6 B2): the job subshell inherits fd 8 (the same open file description, so the same flock) and writes its
  # own ledger entry, keyed to its own pid, before it closes fd 8. The waiter closes its fd 8 instead of `flock -u` (which would unlock the
  # shared description for both), so the lock is released only once BOTH have closed it: a waiter SIGKILLed after the spawn can no longer
  # let the next grant read a ledger without this launch. A subshell killed before its entry has launched nothing.
  (
    ledger_add "$ID" "$BASHPID"; exec 8>&-
    cd "$CO"; : > "$B/build.log"
    if wants_jbct "$@"; then   # jbct plugin bootstrap (see bb-jbct-bootstrap); any other ticket never touches the helper, installed or not
      HELPER=$(dirname "$SELF")/bb-jbct-bootstrap
      if [ ! -x "$HELPER" ]; then echo "bootstrap: refused: helper $HELPER missing or not executable (rc=88)" >> "$B/build.log"; date +%s > "$B/end"; write_rc "$B" 88; exit 88; fi
      "$HELPER" "$CO" "$MVN" "$T" "$@" >> "$B/build.log" 2>&1 || { rc=$?; date +%s > "$B/end"; write_rc "$B" "$rc"; exit "$rc"; }
    fi
    if [ "$(field "$T" iso)" = 1 ]; then
      "$(dirname "$SELF")/bb-netns-run" "$ID" "$CO" "$MVN" "$@" ${RDF[@]+"${RDF[@]}"} >> "$B/build.log" 2>&1
    else
      env -u HCLOUD_TOKEN BB_TICKET="$ID" JAVA_HOME=/usr/lib/jvm/java-25-openjdk-amd64 "$MVN" "$@" ${RDF[@]+"${RDF[@]}"} >> "$B/build.log" 2>&1
    fi
    rc=$?; date +%s > "$B/end"
    if [ "$rc" = 0 ]; then   # bb-test lane: classpath + manifest of a GREEN build; bounded, and never changes rc
      timeout -k 10 "${BB_CP_RECORD_TIMEOUT:-300}" "$(dirname "$SELF")/bb-cp-record" record "$CO" "$@" >> "$B/build.log" 2>&1
      case $? in
        124|137) # a SIGKILLed bb-cp-record leaves its maven running: kill that recorded process group, after an identity check (vbt4 L4)
          { read -r PG PS 2> /dev/null < "$B/cp-record.pgid" && case "$PG" in ''|*[!0-9]*) false;; esac && [ "$(pstart "$PG")" = "$PS" ] \
              && kill -KILL -- "-$PG" 2> /dev/null && echo "bb-build: cp-record's maven (process group $PG) killed" >> "$B/build.log"; } || true
          rm -f "$B/cp-record.pgid"
          echo "bb-build: cp-record skipped: timeout after ${BB_CP_RECORD_TIMEOUT:-300}s (no record is left; bb-test will refuse until a rebuild)" >> "$B/build.log"; rm -rf "$B/cp" "$B/cp.new" "$B/cp.old";;
      esac
    fi
    write_rc "$B" "$rc"   # convenience copy for pollers, 444; the ticket's rc= comes from this subshell's exit status below
    exit "$rc"
  ) &
  C=$!   # the job subshell lives as long as maven / bb-test's java / bb-netns-run (and survives a kill -9 of this waiter)
  exec 8>&-   # the lock covers the slot decision and the ledger write only, never the launch's run time (released when the subshell closes fd 8)
  wait "$C"; BRC=$?   # the build's exit status: the verdict. Never re-read from $B/rc, which a lane can delete or rewrite
  LF="" REJ=""   # LAUNCH FIELDS (header): read before the lock, so a slow or hostile file never holds the queue; set -e: every read is || true
  rej() { case ",$REJ," in *",$1,"*) ;; *) REJ=${REJ:+$REJ,}$1;; esac; echo "bb-build: launch fields: rejected $1${2:+: $2}" >> "$B/build.log"; }
  HT=$(run_ticket "$CO" 2> /dev/null | head -c 128 | head -n 1) || true   # the lib's reader (#80); bounded: head ends the pipe (SIGPIPE) after 128 bytes; an absent run ticket reads as "" = mismatch
  for f in "$B"/fields.*; do
    [ -e "$f" ] || [ -L "$f" ] || continue
    n=${f##*/fields.}
    if [ -z "${BB_LAUNCH:-}" ]; then rej not_launch "$f"
    elif [ "$n" != "$ID" ]; then rej foreign_file "$f names ticket $n, not $ID"
    elif [ -L "$f" ] || [ ! -f "$f" ]; then rej not_regular "$f"
    elif [ "$HT" != "$ID" ]; then rej ticket_mismatch "the checkout's run ticket reads '${HT//[^A-Za-z0-9_-]/?}', not $ID"
    else
      X=$(timeout -k 5 10 head -c 65536 "$f" 2> /dev/null | LC_ALL=C awk '
        { k = ""; if (match($0, /^[A-Za-z0-9_]+=/) && RLENGTH <= 33) { k = substr($0, 1, RLENGTH - 1); v = substr($0, RLENGTH + 1) } }
        k == "verdict_source" && (v == "guard" || v == "java") { print; next }
        k == "refused" && length(v) <= 1024 && v ~ /^[^=[:cntrl:]][^[:cntrl:]]*$/ { print; next }
        { print "#rej " (k == "" ? "malformed" : k) }') || rej unreadable "$f"
      while IFS= read -r l; do case $l in '') ;; '#rej '*) rej "${l#\#rej }" "a line of $f";; *) LF=${LF:+$LF$'\n'}$l;; esac; done <<< "$X"
    fi
    rm -f "$f"
  done
  NOPASS=""; [ -z "$REJ" ] || { LF=${LF:+$LF$'\n'}fields_rejected=${REJ:0:256}; NOPASS=1; }
  if [ -n "${BB_LAUNCH:-}" ] && ! grep -q '^verdict_source=' <<< "$LF"; then LF=${LF:+$LF$'\n'}verdict_source=missing; NOPASS=1; fi
  WRC=$BRC; [ -z "$NOPASS" ] || [ "$BRC" != 0 ] || WRC=18   # never a pass (header: LAUNCH FIELDS); a non-zero rc is kept as it is
  exec 8> "$Q/.lock"; flock 8
  [ -f "$T" ] || exit 0   # cancel or reap already finalized this ticket (first writer wins): do not recreate running/<id> or overwrite done/<id>
  { [ -z "$LF" ] || printf '%s\n' "$LF"; printf 'state=finished\nrc=%s\nended=%s\n' "$WRC" "$(cat "$B/end" 2>/dev/null || date +%s)"; } >> "$T"
  to_done "$T"
  exit 0
fi

SINCE=""
if [ "${1:-}" = --since ]; then
  [ -n "${2:-}" ] && [ -n "${3:-}" ] || { echo "refusing: --since needs <base> and a checkout" >&2; exit 2; }
  [[ $2 =~ ^[A-Za-z0-9._/~^@{}-]{1,200}$ ]] && [[ $2 != -* ]] || { echo "refusing: --since base must be a git ref (^[A-Za-z0-9._/~^@{}-]{1,200}\$, not starting with -)" >&2; exit 2; }
  SINCE=$2; shift 2
fi
CO=$(cd "$1" && pwd); shift
# Ownership guard (2026-09-27, after a cross-agent build into another agent's checkout):
# every caller declares BB_OWNER (its agent prefix, e.g. s5, v1552); a checkout belongs to the
# owner whose "<owner>-" prefix its directory name carries. No match -> refuse, before any write.
: "${BB_OWNER:?refusing: set BB_OWNER=<your agent prefix>; checkout names must start with <prefix>-}"
case "$BB_OWNER" in *[!A-Za-z0-9_]*|"") echo "refusing: BB_OWNER must be [A-Za-z0-9_]+" >&2; exit 4;; esac
case "$(basename "$CO")" in "$BB_OWNER"-*) ;; *) echo "refusing: $CO is not owned by BB_OWNER=$BB_OWNER (name must start with $BB_OWNER-)" >&2; exit 4;; esac
[ $# -gt 0 ] || set -- clean install
MODS=""; SINCE_REASON=""
if [ -n "$SINCE" ]; then
  [ -f "$(dirname "$SELF")/bb-modules.py" ] || { echo "refusing: --since needs bb-modules.py next to bb-build" >&2; exit 2; }
  case " $* " in *" -pl "*|*" --projects"*|*" -pl"[!\ ]*|*" -am "*|*" -amd "*|*" -f "*|*" --file"*) echo "refusing: --since expands to its own -pl; the args already select modules" >&2; exit 2;; esac
  SEL=$(python3 "$(dirname "$SELF")/bb-modules.py" "$CO" "$SINCE") || { echo "refusing: bb-modules.py failed for base $SINCE in $CO" >&2; exit 2; }
  case $SEL in
    NONE) echo "bb-build: nothing changed since $SINCE; nothing queued"; exit 0;;
    FULL|"FULL "*) MODS=FULL; SINCE_REASON=$(printf '%s' "${SEL#FULL}" | tr -c 'A-Za-z0-9._/:@+-' '?'); SINCE_REASON=${SINCE_REASON#\?}
       echo "bb-build: --since $SINCE -> FULL reactor (${SINCE_REASON:-no reason given})";;
    *) MODS=$(printf '%s' "$SEL" | tr ',' '\n' | wc -l | tr -d ' '); MODS=$((MODS + 1)); set -- -pl "$SEL" "$@"
       echo "bb-build: --since $SINCE -> -pl $SEL ($MODS modules)";;
  esac
fi
case "${BB_REQUIRE_DOCKER:-1}" in 0|1) ;; *) echo "refusing: BB_REQUIRE_DOCKER must be 0 or 1 (or unset)" >&2; exit 2;; esac
B=$CO/.bb; mkdir -p "$B"
if [ ! -f "$B/rc" ] && [ -f "$B/start" ]; then
  # .bb/start without .bb/rc: a build still running, or a finished build whose .bb/rc a lane deleted (CTO 2026-11-13: three verifier
  # lanes rm'd it to "reset" a checkout). Name the second case: no waiting/running ticket for this checkout and the done/ ticket named by .bb/ticket (#80; was: whose started= is this .bb/start), state=finished and a numeric rc= (its build wrote .bb/rc; an orphaned or cancelled run may never have).
  # Anything else (e.g. a BB_QUEUE=0 build, which has no ticket) keeps the running message. One direct done/<ticket> lookup: done/ holds tens
  # of thousands of tickets, so no scan (v50a: a field() fork per file took ~2 min on bigboy).
  TK=$(run_ticket "$CO" || true)   # unknown (no .bb/ticket) leaves TK empty: the plain message below
  LIVE=""; FIN=""
  for f in "$Q"/waiting/* "$Q"/running/*; do [ -f "$f" ] && [ "$(field "$f" co)" = "$CO" ] && LIVE=${f##*/}; done
  if [ -z "$LIVE" ] && [ -n "$TK" ] && [ -f "$Q/done/$TK" ]; then   # #80: .bb/ticket names the run that owns .bb; none (pre-#80 run) = no guess
    f=$Q/done/$TK
    [ "$(field "$f" co)" = "$CO" ] && [ "$(field "$f" state)" = finished ] && [[ $(field "$f" rc) =~ ^[0-9]+$ ]] && FIN=$TK
  fi
  [ -z "$FIN" ] || { echo "refusing: .bb/rc in $CO was deleted by hand after ticket $FIN finished; never rm it (its verdict is the ticket record: bb-wait $FIN); rerun bb-build in a fresh checkout (a rerun in a checkout whose .bb/rc is intact clears it itself)" >&2; exit 3; }
  echo "refusing: a build appears to be running in $CO (.bb/start without .bb/rc)" >&2; exit 3
fi
# Host-killing test guard (2026-09-27, #1553): StreamPublishReshuffleTest leaks sockets without bound and
# exhausted this host's ephemeral ports twice. Unless this checkout's copy carries the #1553 @Disabled, refuse
# any invocation that names it or that selects Heavy forge tests without explicitly excluding it.
SPRT="$CO/aether/forge/forge-tests/src/test/java/org/pragmatica/aether/forge/StreamPublishReshuffleTest.java"
if [ -f "$SPRT" ] && ! grep -q '@Disabled("#1553' "$SPRT"; then
  ARGS=" $* "
  if printf '%s' "$ARGS" | grep -Eq '[^!]StreamPublishReshuffleTest'; then
    echo "refusing: this run names StreamPublishReshuffleTest (#1553 host-killing leak; see runbook 0c)" >&2; exit 6; fi
  # the exclusion must sit in -Dit.test: forge-tests runs through failsafe, which ignores -Dtest (2026-09-29)
  if printf '%s' "$ARGS" | grep -Eq 'groups=[^ ]*Heavy|excludedGroups= |-Pwith-e2e' && ! printf '%s' "$ARGS" | grep -Eq -- ' -Dit\.test=[^ ]*!StreamPublishReshuffleTest'; then
    echo "refusing: Heavy/e2e forge selection without '-Dit.test=…,!StreamPublishReshuffleTest' (#1553; see runbook 0c; -Dtest does not reach failsafe)" >&2; exit 6; fi
fi
# Failsafe filter guard (2026-09-29, s3's forge run at 36b5c3d42): forge-tests skips surefire and runs every test through
# failsafe, which reads -Dit.test and IGNORES -Dtest. A run that names forge-tests (-pl or -f), reaches integration-test,
# and filters with -Dtest but not -Dit.test would run the whole IT suite. Refuse (rc 10); BB_IT_UNFILTERED=1 overrides.
A=" $* "
if [ "${BB_IT_UNFILTERED:-0}" != 1 ] && printf '%s' "$A" | grep -Eq -- ' (-pl|--projects|-f|--file)[= ]?[^ ]*forge-tests' \
   && printf '%s' "$A" | grep -Eq -- ' -Dtest=' && ! printf '%s' "$A" | grep -Eq -- ' -Dit\.test=' \
   && printf '%s' "$A" | grep -Eq ' (integration-test|verify|install|deploy) '; then
  echo "refusing: forge-tests runs through failsafe, which ignores -Dtest; filter with -Dit.test=… (BB_IT_UNFILTERED=1 to run the whole IT suite)" >&2; exit 10
fi
# Concurrency cap (2026-09-27): above 3 concurrent reactors, fixed-port tests collide (BindException)
# and Testcontainers fails to start, so results are environmental noise. The queue grants a ticket only while
# fewer than CAP queue launches (the LEDGER: what this queue started, maven or bb-test's java alike) run, and never more than the host cap (~/work/max-reactors, #56). Override the cap only with BB_MAX_REACTORS. BB_CAP_WAIT_SECS > 0 bounds the
# queue wait (then .bb/rc = 5); unset = wait until granted.
CAP=${BB_MAX_REACTORS:-5}; LIMIT=${BB_CAP_WAIT_SECS:-0}
case "$CAP$LIMIT" in *[!0-9]*) echo "refusing: BB_MAX_REACTORS / BB_CAP_WAIT_SECS must be non-negative integers" >&2; exit 2;; esac
# cap=1 is for ROOT builds only (2026-09-29): a module build (-pl/-f) with BB_MAX_REACTORS=1 would wait for an EMPTY host
# and, before backfill, blocked every ticket behind it. Warn and use the default cap.
if [ "$CAP" = 1 ] && printf ' %s ' "$*" | grep -Eq -- ' (-pl|--projects|-f|--file)([= ]|[^ ]*/)'; then
  echo "WARNING: BB_MAX_REACTORS=1 is for root builds only; this is a module build (-pl/-f), so the default cap 5 is used" >&2
  CAP=5
fi

# Dedup key: HEAD + maven.config (minus the per-checkout repo.local line) + args. Only for a CLEAN tree: a dirty
# tree (a mutation probe, local edits) is the same SHA with different content, so it is never deduped.
case "${BB_PORT_GROUP:-}" in
  1|0) GROUP="$BB_PORT_GROUP forced by BB_PORT_GROUP=$BB_PORT_GROUP";;
  "") GROUP=$(python3 "$(dirname "$SELF")/bb-portgroup.py" "$PGM" "$CO" "$@" 2>/dev/null) || GROUP="1 classifier failed"
      case "$GROUP" in [01]\ *) ;; *) GROUP="1 classifier gave no answer";; esac;;
  *) echo "refusing: BB_PORT_GROUP must be 0, 1 or unset" >&2; exit 2;;
esac

SHA=$(git -C "$CO" rev-parse HEAD)
KEY=""
if [ -z "$(git -C "$CO" status --porcelain --untracked-files=normal)" ]; then
  KEY=$( { printf '%s\n' "$SHA"; grep -v '^-Dmaven.repo.local=' "$CO/.mvn/maven.config" 2>/dev/null; printf '%s\0' "$@"; [ "${BB_REQUIRE_DOCKER:-1}" = 1 ] || printf 'requireDocker=0\0'; } | sha256sum | cut -c1-16)
else
  echo "dedup: skipped (working tree has changes vs $SHA)"
fi

exec 8> "$Q/.lock"; flock 8
reap
QD=$(cat "$B/queued" 2>/dev/null || true)
if [ -n "$QD" ] && [ -f "$Q/waiting/$QD" ]; then echo "refusing: $CO already has queued ticket $QD" >&2; exit 3; fi
if [ -n "$KEY" ] && [ "${BB_DEDUP:-1}" != 0 ]; then
  for f in "$Q"/running/* "$Q"/waiting/*; do
    [ -f "$f" ] && [ "$(field "$f" key)" = "$KEY" ] || continue
    echo "dedup: identical build is $(basename "${f%/*}"): ticket=${f##*/} owner=$(field "$f" owner)" >&2
    echo "dedup: read its result at $(field "$f" co)/.bb (poll for rc); BB_DEDUP=0 to run anyway" >&2; exit 7
  done
  for f in $(ls -t "$Q"/done/ 2>/dev/null); do
    f=$Q/done/$f
    [ "$(field "$f" key)" = "$KEY" ] && [ "$(field "$f" state)" = finished ] || continue
    o=$(field "$f" co)
    [ -f "$o/.bb/rc" ] && run_current "$o" "${f##*/}" || continue   # since rebuilt/removed: not current, and unknown (no .bb/ticket, a pre-#80 run) counts as not current (#80)
    echo "dedup: identical build already finished: rc=$(field "$f" rc) ended=$(date -d @"$(field "$f" ended)" -Is) owner=$(field "$f" owner)" >&2
    echo "dedup: read its result at $o/.bb (bb-report $o); BB_DEDUP=0 to run anyway" >&2; exit 8
  done
fi

# Ticket owner fields (T3): each optional, each validated; a bad value is dropped with a notice and never blocks the build.
OWNER_FIELDS=""
[ -z "$SINCE" ] || OWNER_FIELDS+="since=$SINCE"$'\n'"modules=$MODS"$'\n'
[ -z "$SINCE_REASON" ] || OWNER_FIELDS+="since_reason=$SINCE_REASON"$'\n'
ownerval() {  # ownerval <BB_NAME> <regex> -> value on stdout when set and valid; notice on stderr when set and malformed
  local v=${!1:-}
  [ -n "$v" ] || return 1
  [[ $v =~ $2 ]] && { printf '%s' "$v"; return 0; }
  echo "bb-build: ignoring $1: not $2" >&2; return 1
}
LABEL_RE='^[A-Za-z0-9._:-]{1,64}$'; WORD_RE='^[A-Za-z0-9._-]{1,64}$'
SP=$(ownerval BB_SESSION_PID '^[1-9][0-9]{0,9}$') || SP=""
SS=$(ownerval BB_SESSION_START '^[1-9][0-9]{8,10}$') || SS=""
SL=$(ownerval BB_SESSION_LABEL "$LABEL_RE") || SL=""
if [ -n "$SP" ] && [ -n "$SS" ] && [ -n "$SL" ]; then
  OWNER_FIELDS+=$(printf 'session_pid=%s\nsession_start=%s\nsession_label=%s\n' "$SP" "$SS" "$SL")$'\n'
elif [ -n "${BB_SESSION_PID:-}${BB_SESSION_START:-}${BB_SESSION_LABEL:-}" ]; then
  echo "bb-build: ignoring BB_SESSION_PID/BB_SESSION_START/BB_SESSION_LABEL: need all three, each valid" >&2
fi
AG=$(ownerval BB_AGENT "$WORD_RE") && OWNER_FIELDS+="agent=$AG"$'\n'
LN=$(ownerval BB_LANE "$WORD_RE") && OWNER_FIELDS+="lane=$LN"$'\n'
PRN=$(ownerval BB_PR '^[1-9][0-9]{0,9}$') && OWNER_FIELDS+="pr=$PRN"$'\n'
VIA=$(ownerval BB_VIA "$LABEL_RE") && OWNER_FIELDS+="via=$VIA"$'\n'   # who submitted: bb-mutate sets bb-mutate:<spec>:<mutant> (issue #46); additive
OWNER_FIELDS+="output=$B/build.log"$'\n'
[ "${BB_REQUIRE_DOCKER:-1}" = 1 ] || OWNER_FIELDS+="requireDocker=0"$'\n'
[ -z "${BB_LAUNCH:-}" ] || OWNER_FIELDS+="requireDockerEffective=$([ "${BB_REQUIRE_DOCKER:-1}" = 1 ] && echo true || echo false)"$'\n'   # bb-test tickets only (CTO 2026-11-19): a count without Testcontainers must never read as a full one
[ -z "$DETACHED_READER" ] || OWNER_FIELDS+="detached_reader=$DETACHED_READER"$'\n'

ID=$(date +%s%N)-$$
T=$Q/waiting/$ID
rm -f "$B/rc" "$B/end" "$B/start" "$B/ticket"
echo "bb-build: queued ticket $ID at $(date -Is); maven has not started (bb-queue shows position)" > "$B/build.log"
echo "$ID" > "$B/queued"
{ printf 'id=%s\nowner=%s\nco=%s\nsha=%s\nkey=%s\ncap=%s\nlimit=%s\ncreated=%s\n' \
    "$ID" "$BB_OWNER" "$CO" "$SHA" "$KEY" "$CAP" "$LIMIT" "$(date +%s%N)"
  printf 'group=%s\ngroup_reason=%s\n' "${GROUP%% *}" "${GROUP#* }"
  [ "${GROUP%% *}" = 1 ] && [ "${BB_PG_ISOLATE:-1}" != 0 ] && command -v docker > /dev/null && printf 'iso=1\n'
  printf '%s' "$OWNER_FIELDS"
  printf 'args='; printf '%q ' "$@"; printf '\n'; } > "$T"
setsid nohup bash "$SELF" __run "$ID" "$@" < /dev/null > /dev/null 2>&1 8>&- &
for _ in $(seq 50); do waiter_alive "$ID" && break; sleep 0.1; done
waiter_alive "$ID" || { rm -f "$T" "$B/queued"; echo "error: waiter for $ID did not start" >&2; exit 1; }
POS=$(order | grep -nx -- "$ID" | cut -d: -f1 || true)
echo "queued ticket=$ID position=$POS priority=$(prio "$BB_OWNER" "$SHA") reactors=$(reactors) cap=$CAP port-group=${GROUP%% *} (${GROUP#* }) port-group-holders=[$(group_holder)] slots=$(pg_slots) log=$B/build.log args: $*"
