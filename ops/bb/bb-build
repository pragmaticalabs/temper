#!/usr/bin/env bash
# bb-build <checkout-dir> [mvn args...]  (default args: clean install)
# QUEUED since 2026-09-28: after the guards below, the build is DEDUPED against identical builds, then ENQUEUED and
# this command returns at once; a detached waiter launches maven when its ticket is granted (priority order from
# ~/work/priorities, FIFO among equals, under the reactor cap). Poll for .bb/rc exactly as before.
# Writes in <checkout>/.bb/: queued (ticket id, while waiting), run.marker (at launch), ticket (the granted run's ticket id, written with start), build.log, start/end
# epochs, rc (a 444 convenience copy of maven's exit code, written INSIDE the job; 5 = queue wait expired, 9 = cancelled/abandoned
# before maven started; 19 = maven ended 0 but a selected test class ran 0 testcases, see ZERO-TESTCASE REFUSAL). Call rc: 0 queued; 2 usage; 3 already running/queued here; 4 owner; 6 #1553 guard;
# 7 identical build running/queued elsewhere; 8 identical build already finished (paths printed); 19 BB_QUEUE=0 with a counted selector
# (ZERO-TESTCASE REFUSAL); 10 -Dtest without
# -Dit.test on forge-tests (failsafe ignores -Dtest); 11 -pl without -am/-amd, a lifecycle phase at or after `compile`, and a reactor module the run resolves not installed (UNINSTALLED SIBLING, below). BB_DEDUP=0
# skips dedup; a bb-mutate call (BB_VIA bb-mutate:*) has no dedup key, so nothing dedups onto its ticket either. DEDUP IDENTITY (#80, 2026-11-21): a finished identical build is still the checkout's result only while .bb/ticket names ITS ticket (not while
# .bb/start equals its started=: two runs granted in one second shared a start, and dedup answered with the newer run's result). A checkout with no
# .bb/ticket (run before this change) is not current: no dedup, the safe direction. BB_QUEUE=0 runs the pre-queue script (bb-build-direct) -- it also bypasses the port group -- after removing .bb/ticket (that run writes .bb/start only, so an older ticket must not stay current).
# PORT GROUP (2026-09-29): a run that will execute tests of a fixed-port module (~/work/port-group-modules; decided by
# bb-portgroup.py from the checkout's own poms and the args) is granted only while no other port-group run is running.
# BB_PORT_GROUP=1 forces membership, BB_PORT_GROUP=0 forces exclusion.
# REQUIRE DOCKER (2026-11-12): both maven launches below end with -Daether.requireDocker=true, after the caller's args (pragmatica #2591: a Docker IT
# class FAILS instead of silently not running when Docker is absent; temper ignores the property). Override point (#31, 2026-11-12):
# BB_REQUIRE_DOCKER=0 at enqueue omits the flag from both launches, for a run that must see how a guard behaves WITHOUT it (pragmatica #3090);
# the value is ^[01]$ (anything else: refused, exit 2, nothing queued), unset or 1 = the flag as above. A 0 ticket carries the line
# requireDocker=0 (bb-tickets shows it, bb-queue marks the row [no-requireDocker]) and a 0 build is never deduped against a guarded one.
# ISOLATED SLOTS (2026-11-11): a group ticket's maven runs inside its own docker network namespace (bb-netns-run: host userland
# mounted read-only, checkout and $HOME at the same paths, own loopback), so identical fixed ports cannot collide and up to N
# (~/work/port-group-slots, default 3) group tickets run at once per host, each holding a slot (bb-queue shows it). No change to the
# tests. BB_PG_ISOLATE=0 at enqueue = the old host-exclusive behaviour for that ticket (ticket has no iso=1).
# MUTANT TICKETS (#116): a ticket with via=bb-mutate:* (BB_VIA). bb-mutate also passes BB_ORDER_AT (epoch NANOseconds, the submit time of its
# whole run, taken once before the control build), BB_DRIVER_PID and BB_DRIVER_START (its pid and /proc start time) and BB_MUTANT_BOUND
# (seconds); the ticket then carries order_at= driver_pid= driver_start= bound=.
#   TURN, per host: a waiting mutant ticket is ELIGIBLE only while its owner has no mutant ticket in running/ and none in waiting/ with a smaller
#     created= (tie: ticket id). grantable() in the lib tests it at every grant test, in the lock hold that moves the ticket to running/, so
#     at most ONE mutant ticket per owner runs on a host and an owner's batches alternate build by build. A ticket that is not eligible
#     takes no part in pick: no blocked_since=, never in an override, blocks nothing. The call is never refused for it. NOT COVERED: other
#     hosts; a waiter that sourced the lib of before #116 (it grants its own ticket by the old rule). Every mutant ticket counts, with or
#     without order_at=. Priority does not reorder one owner's mutant tickets among themselves: the older one goes first.
#   ORDER: order() in the lib sorts a ticket by order_at= instead of created= WITHIN its priority (a higher priority still goes first), so it
#     places the eligible one against OTHER owners' tickets. It is still gated (load, memory, caps, port group) at its own grant; created=
#     (turn, starvation override, ticket log) is its true enqueue time. FAIRNESS BOUND: at one priority, a ticket created at c is overtaken by
#     later-created tickets only of runs that started before c: at most one at a time per owner, and in all at most the builds such a run
#     still has (control + mutants + batch re-runs). No time bound, and blocked_since= does not limit it.
#   ACCEPTED ONLY when ALL hold, else call rc 2 and nothing queued: BB_ORDER_AT is 19 digits, not later than now and not earlier than the driver's
#     start (start_ns: up to 1 s of slack; a forward step of the wall clock by more during a run refuses its later builds ("before the start of its driver"),
#     and so does a BACKWARD step by more than the run's age, the time since its BB_ORDER_AT ("is in the future"): rc 2 for each later call until the clock is back); BB_VIA matches
#     ^bb-mutate:[A-Za-z0-9._-]{1,20}:[A-Za-z0-9._-]+$; BB_MUTANT_BOUND is 1 to 6 digits, not 0; the driver pid runs with that start time, its
#     command line is `python* .../bb-mutate` and it is an ancestor process of this call. WHAT THAT DOES NOT COVER: BB_VIA alone is an env
#     value anyone can set (such a ticket takes turns with its owner's, no more); the driver check ties the call to a live process NAMED
#     bb-mutate, not to a reviewed bb-mutate. It stops a stray or inherited BB_ORDER_AT, not a deliberate same-uid forgery.
#   DRIVER GONE: the ticket's waiter checks the driver at every poll (5 s), in the lock hold of its grant test, and moves a WAITING ticket
#     whose driver is gone to done/ (state=abandoned, .bb/rc 9). A RUNNING ticket is never touched on driver death.
#   BOUND: the waiter starts a runner (`bb-build __bound`) with the job: a job still running bound= seconds after its start is stopped (its process
#     tree, its container, java processes whose cwd is the checkout; nothing else, so not a driver or shell standing there), with a live driver or without; the
#     ticket gets bound_hit=, rc=124 and .bb/rc 124. A job that returned by itself first gets job_end= instead (its rc is kept, whatever the count
#     and bb-cp-record after it take). WHEN: bound_hit= comes bound to bound + 2 s after the grant (whole seconds rounded up, so never before the
#     bound; one test a second; plus a wait for the queue lock). Then TERM after one /proc scan, KILL 5 s later to what ignores it, two more scans,
#     .bb/rc: measured 4 to 8 s after bound_hit=, 9 to 10 s for a job that ignores TERM (300 processes on the host; a scan grows with them,
#     and a stop that left survivors is retried, so there is no fixed upper limit).
#     A runner outlives its waiter; NOT COVERED: the runner itself killed, and tickets without bound= (a bb-mutate of before #116). A ticket still WAITING
#     when bb-build is rolled back (the installer's reverse order) runs WITHOUT its bound: its waiter starts the runner as `bash <this file> __bound`, at
#     the grant, and the file is then the bb-build of before #116, which has no such mode (it ends at once; the ticket gets no bound_hit=).
#     bb-mutate reads .bb/rc 124 as the bound only when the ticket carries bound_hit=; a job's own exit 124 is an ordinary rc.
# The four variables are unset before the waiter (or, under BB_QUEUE=0, bb-build-direct) starts, so a build never inherits them.
# LOAD GATE (2026-11-11): a ticket is also granted only while load5/cores < 1.2 (BB_LOAD_MAX); the oldest grantable ticket goes
# once it waited > 1200 s (BB_LOAD_STARVE_SECS) while < 2 queue launches run (BB_LOAD_STARVE_REACTORS). MEMORY FLOOR (#53): a grant also
# needs MemAvailable >= the per-host floor; the oldest ticket overrides it only while no ticket runs at all. pick() in the lib decides.
# HOST CAP (#56): a grant also needs live queue launches (the lib's LAUNCH LEDGER, never a process pattern) < min(this ticket's cap, the host's ~/work/max-reactors, default 3); nothing overrides it.
# Off-queue JVMs (#56): the memory floor is compared against MemAvailable minus their unclaimed heap, max(0, Xmx - RSS) each.
# VERDICT SOURCE (2026-11-12, bbrc1; reap and too-late cancel fixed 2026-11-13): the ticket's rc= is the exit status of the build subshell
# as returned by `wait` in the waiter, never a read of .bb/rc. A ticket whose waiter is gone (reap, or a cancel that finds the build
# already ended) is finalized as orphaned with NO rc: bb-wait exits 70, and .bb/rc is not read into it. .bb/rc is a read-only (444) copy
# written before the ticket is finalized, replaced only by rm/rename (write_rc in the lib), never by `>`.
# GUARANTEE: the verdict comes from mvn's exit status, never from the checkout; any later disagreement in the checkout is detected (RC-MISMATCH, exit 71); deliberate tampering with queue/done by the same uid stays possible.
# BB-TEST (2026-11, bb-test lane): a GREEN build then runs bb-cp-record (offline test-compile + dependency:build-classpath; writes .bb/cp/<module>.cp and
# .bb/cp/manifest for bb-test's stale-jar guard); its failure is logged and never changes rc, and it is bounded by BB_CP_RECORD_TIMEOUT seconds
# (default 300; on timeout: "cp-record skipped: timeout" in the log, any record removed, write_rc delayed by at most the bound + 10 s). BB_LAUNCH=<cmd> makes the waiter run <cmd> instead of maven
# (bb-test's own __launch mode); such a ticket sets BB_NO_CP_RECORD=1 and BB_DEDUP=0.
# LAUNCH FIELDS (#76, CTO ruling 2026-11-21): every job gets BB_TICKET=<its id> (bb-netns-run passes it into the container); bb-test's __launch
# never sees the queue and writes its ticket fields to .bb/fields.<id>. That file is UNTRUSTED (test code can write the checkout). Once the
# job has exited, the waiter reads it (before the queue lock: a regular file, not a symlink, at most 64 KiB, under a 10 s timeout) and
# appends, under the queue lock in the same append as (just before) state=finished/rc=, ONLY lines of this grammar (C locale, byte counts):
#   verdict_source=guard | verdict_source=java     (nothing else)
#   refused=<v>   v: 1..1024 bytes, no control byte (so no CR/LF/NUL injection), first byte not '='
# Every other line is rejected by its key (malformed: no <[A-Za-z0-9_]{1,32}>= key), and so is the whole file when the ticket is not a
# BB_LAUNCH one (not_launch), it names another id (foreign_file), it is not regular (not_regular), it cannot be read (unreadable) or
# .bb/ticket does not read <id> (ticket_mismatch). Rejections are recorded as one fields_rejected=<token>[,<token>...] line (at most 256
# bytes; details in build.log). Under the lock, just before the append, the run ticket is read again (run_ticket): a marker that no longer reads <id> drops the copied lines and records fields_rejected=ticket_changed + verdict_source=missing (never a pass); a process the job left behind can still rewrite its OWN fields between the read and the lock, within the grammar (accepted, CTO 2026-11-21). BB_TEST_BEFORE_LOCK=<cmd> (TEST SEAM, inert unless set) runs in that window. A BB_LAUNCH ticket with no accepted verdict_source gets verdict_source=missing (a crash, OOM or kill
# before bb-test wrote it). A rejection or a missing verdict is never a pass: a job rc of 0 is then recorded as rc=18; a non-zero rc is
# kept. .bb/rc stays the job's own exit status. Every .bb/fields.* is removed at the grant and after the read.
# Every ticket reaching done/ appends one line to ~/work/bb-ticket-log.tsv. `bb-wait <ticket>` blocks until it finishes (exit = rc).
# TICKET OWNER FIELDS (T3, 2026-11): the ticket gains optional key=value lines after group_reason= and before args= (readers
# take the LAST line of a key, so every existing reader ignores them): session_pid, session_start (epoch s) and session_label
# from BB_SESSION_PID / BB_SESSION_START / BB_SESSION_LABEL (all three or none), agent, lane, pr from BB_AGENT, BB_LANE, BB_PR,
# output (always <checkout>/.bb/build.log) and detached_reader from `bb-build --detached --reader <label> <checkout> [args]`
# (those three words first, in that order; refused with rc 2 under BB_QUEUE=0 or without --reader; the flag is not part of the
# maven args or the dedup key). A malformed value never blocks a build: "bb-build: ignoring BB_<NAME>: not <regex>" on stderr,
# the field is omitted. Old callers set none of these.
# INCREMENTAL (2026-11-19, design docs/bb-build-once-design.md §1): `bb-build [--detached --reader L] --since <base> <checkout> [goals]` asks
# bb-modules.py (next to this file) for the module set S = am(C u amd(C)) of the paths changed since <base> (git diff <base>...HEAD, dirty
# tracked and untracked files), prints it, and runs the goals with an explicit `-pl S` (no -am/-amd: the closure already covers the whole
# set, so no upstream resolves from a stale .m2-local jar). FULL (root/parent pom, .mvn/, unmapped path, unparsable pom; the cause goes on the since_reason= ticket line) keeps the whole
# reactor; NONE (no change at all) prints "nothing changed", queues nothing and exits 0. The ticket gains since=<base> and modules=<n|FULL>
# right after group_reason= (same optional-line rule as the owner fields). The dedup key hashes the EXPANDED args. Refused (rc 2): a missing
# or unreadable base, a missing bb-modules.py, or caller args that already carry -pl/-am/-amd/-f (two selections of the modules).
# UNINSTALLED SIBLING (#112, call rc 11, nothing queued; checked after the guards below, before dedup and enqueue). THE RULE: refused only when ALL hold:
# the args carry `-pl`/`--projects` and none of -am/--also-make/-amd/--also-make-dependents; they carry a lifecycle phase at or after `compile` (a plugin goal
# `x:y` alone, such as jbct:check or jbct:format, or `clean`, is never refused); and a reactor module the selected ones resolve has no pom in the repo.
# bb-modules.py --installed reads the checkout's poms. Resolved: a selected jar/war module's direct <dependencies> (from `test-compile` on every scope, before
# it every scope but `test`; a pom-packaged selected module resolves none), and, for each such module that is not itself selected, ITS compile- and runtime-scope
# <dependencies>, transitively; `!x`/`-x` leaves x out of the selected set, so it counts. A dependency is a reactor module only when (groupId, artifactId) both
# match (groupId substituted from the pom's own <properties>, or inherited from the parent; a groupId still holding `${` while its artifactId names a reactor
# module is SKIP, so the run queues); groupId, artifactId and version are whitespace-stripped. Each needed module must have
# <repo>/<groupId path>/<artifactId>/<version>/<artifactId>-<version>.pom, repo = the last -Dmaven.repo.local= of .mvn/maven.config + args, else
# <checkout>/.m2-local. Any missing: refused naming them, "add -am, or install them first" (maven would fail in seconds at dependency resolution with 0
# testcases, a lane round lost). -pl forms: `-pl a,b`, `-pl=a`, `-pla`, `--projects[=]a`, `?a`, `:artifactId`, `g:a`, `!x`/`-x`. NOT refused (a note on stderr): a
# form it cannot resolve (unknown selector, `-f`, a coordinate left holding `${`, unreadable poms). Not checked: group mode, --since (its own -pl already covers
# the closure), BB_QUEUE=0, -pl given only in .mvn/maven.config. LIMITS: a stale installed sibling passes (as in plain maven); only the .pom is looked for (not the
# jar); -amd alone passes although it does not add upstreams (the caller's choice of flag is trusted); a plugin or parent-only edge is not modelled; a
# runtime-scope direct dependency counts before test-compile although maven does not resolve it at `compile` (over-refusal, rare); a goal that resolves
# dependencies without a lifecycle phase (dependency:tree) is not checked.
# JBCT BOOTSTRAP (2026-11-19, feat/bb-jbct-bootstrap): a run that asks for a jbct:* goal, an org.pragmatica-lite:jbct-maven-plugin:* goal or the jbct
# profile, in a checkout whose .m2-local lacks the jbct-maven-plugin jar of its effective version (the root pom's plugin entry), first runs CI's bootstrap
# (`mvn install -B -DskipTests -pl <ci.yml list at HEAD> -am`) inside the same ticket, same cap and port group, before the main maven
# (bb-jbct-bootstrap holds the rules and its exit codes: failure -> the ticket's rc is the bootstrap's and the main maven does not run;
# 82-87 are refusals; 88 = the helper itself is missing or not executable on a jbct run, refused before any maven). build.log carries `bootstrap: jbct plugin <ver> installed into .m2-local|present|FAILED rc=<n>`; the ticket carries
# jbct_bootstrap=<ver> after an install. The jbct-run test lives here (wants_jbct) and only here; any other run never execs or even looks for the helper and is unchanged. Not part of the dedup key.
# ZERO-TESTCASE REFUSAL (#86; CTO ruling 2026-11-22: ONE invariant, ONE table): selected_testcases, the one counter of EVERY ticket, a
# build's and a bb-test launch's (BB_LAUNCH) alike, run in the job tail on the job's rc. PLUGINS: surefire (selector: the last -Dtest=),
# failsafe (the last -Dit.test=); a launch has one, its Class[#method] args. S(P) = P's POSITIVE selector set: the comma-separated
# tokens minus `!` exclusions. `none` is special ONLY as a property's exact whole value (case-sensitive: `None`, `none,X` are tokens).
# THE TABLE (a cell's name is its row prefix in BbZeroTestcaseIT and the CELLS name a mutant deletes):
#   cell        when                                                     outcome
#   NOSEL       neither -Dtest nor -Dit.test given (a build)             NOT GATED, rc kept (any rc), but logged (CTO ruling 2026-11-22):
#                                                                        `bb-build: testcases (no selector, not gated): surefire(all)=n failsafe(all)=m`
#   POS         S(P) non-empty                                           every token of S(P) has executed testcases > 0 in P's reports, else 19;
#                                                                        a token in BOTH S(surefire) and S(failsafe) is one token whose count
#                                                                        is the sum over both plugins' reports (CTO 2026-11-27: a failsafe-only
#                                                                        module with surefire skip=true, `-Dtest=X -Dit.test=X,Y`, was 19)
#   ALL         S(P) empty (no selector, only `!`), P not `none`, P RAN  P(all) executed > 0, logged `surefire(all)=n` / `failsafe(all)=n`, else 19
#   NONE        P's selector is exactly `none`                           P is not counted
#   IDLE        a selector given, but no cell above counted anything     19 (both `none`, or no selected plugin ran)
#   REJECT      job rc != 0 because the runner rejected the selection    19, the runner's line passed through (below)
#   UNCOUNTABLE job rc 0, the count cannot be made (no marker, 120 s)   19, never a pass
#   QUEUEOFF    BB_QUEUE=0 and any -Dtest/-Dit.test (`none` included)    19 at the call, nothing run (bb-build-direct writes .bb/rc from its
#                                                                        own detached job, so nothing could count it before a poller reads 0)
# Any other non-zero job rc is kept (a genuine failure stays 1). One exit code means one test: 19 = the selection executed nothing.
# P RAN (a build): build.log has P's test goal execution (`--- [maven-]surefire[-plugin]:<v>:test` / `failsafe...:integration-test`) not
# followed, before the next `--- `, by `Tests are skipped.`; or P wrote a report newer than the marker. (A module set that binds no failsafe
# does not run it, so `-Dtest=X -pl core` is not judged on ITs; limit: a `-q` log shows no execution, and -T interleaving can misplace a skip.)
# REJECT tells a rejection from a failure by the runner's own words: a build, when EVERY `[ERROR] Failed to execute goal` line of build.log
# is a surefire/failsafe goal failing with `No tests matching pattern` / `No tests were executed` (a test failure, compile error or any
# other goal keeps its rc); a launch, when java exited 255 (`bb-test: run i/N java exit 255`) and no testcase of the ticket's reports
# failed or errored. The passed-through line: the goal's message, or java's first `Caused by: ` line (else its first exception line).
# REPORTS: a build reads TEST-<fqcn>.xml under any <module>/target/surefire-reports (surefire) or failsafe-reports (failsafe), nothing else
# (fixture XML under src/ never counts); a launch, its own <module>/target/bb-test-reports/<ticket>/ (--repeat N>1: each run<i>/ is a run of
# its own and every token must be > 0 in EVERY run). Only reports with an mtime newer than .bb/run.marker count. A <testcase> belongs to the
# class its file names, else (the launcher's TEST-junit-jupiter.xml) to its classname. EXECUTED = testcases minus those with a <skipped>
# child (logged `<token>=<n>(+<k> skipped)`). MATCHING: a token's class part (before '#') matches a class or any of its '$'-prefixes (a
# nested Outer$Inner$Deeper counts for Outer and Outer$Inner); a bare name or glob against the simple name, in any module (`Bb*IT` is ONE
# token), a dotted or slashed one against the package path, %regex[...] against the class path (limit: a %regex holding ',' is split).
# build.log: `bb-build: selected testcases: [run<i>:]<token>=<n> ... [surefire(all)=n] [failsafe(all)=n]`, then on refusal
# `[ERROR] bb-build: refused rc <job rc> -> 19: <cell's reason>`; 19 lands in .bb/rc and the ticket's rc= (no bb-cp-record).
# KILL LABEL (#131): the ticket carries the host kernel's window of its run: oom_kill_start= mem_avail_kb_start= (written with started=, under the grant's lock hold) and
# oom_kill_end= mem_avail_kb_end= (read right after the job's wait, written with state=finished); oom_kill is /proc/vmstat's host-wide counter, MemAvailable is in kB, a
# value is `unavailable` when it cannot be read. bb-result (and bb-wait, bb-await through it) turn them into the outcome, never from the number 137 alone:
#   OOM-KILLED  rc 137 AND oom_kill_end > oom_kill_start AND no bound_hit=       the ticket's own process was SIGKILLed while the kernel killed something (some process: a
#                                                                                host-wide counter; a hand-made kill -9 in the same window reads as OOM, see LIMITS)
#   KILLED      rc 124 with bound_hit= (bb-build's bound), or rc 137 with no counter move or an unreadable counter     named in the line; never OOM-KILLED
#   (none)      every other rc: a non-signal non-zero rc is a FAILURE as before, whatever the counter did meanwhile (two tickets at once see the same counter)
# LIMITS: a ticket of before this change has no fields and gets no label; bb-mutate's own kill leaves a ticket with no numeric rc (reap records none); a SIGKILL by hand in a
# window where another process was OOM-killed is labelled OOM-KILLED (the counter has no victim); an OOM kill of a surefire fork leaves maven's rc 1 and no label.
# REPEATED TEST GOAL (#132): a call whose maven args run the same test goal more than once is refused, rc 2, nothing queued, before the first write, the message naming
# `bb-test --repeat N` (one report directory per run): every run of surefire:test writes the same target/surefire-reports files, so a repeat is unobservable and its ticket
# would claim N runs for one report set. UNITS: surefire `test` (the goal, or any phase from `test` on) and failsafe `integration-test` (the goal, or any phase from
# `integration-test` on); a unit named twice in any mix of forms is refused: `surefire:test`, org.apache.maven.plugins:maven-surefire-plugin[:<version>]:test (same for failsafe),
# `<goal>@<execution>` (any id), phases test prepare-package package integration-test post-integration-test verify install deploy (so `test install` is refused, `clean install` and
# `test-compile surefire:test` are not). An option's separate value (-pl x, -T 2, -D k=v, -rf :x) is not a task. NOT refused: failsafe:verify (runs no test), another plugin's
# `x:test`, a bb-test launch (BB_LAUNCH; its args are not a goal list). Checked on the queue path and under BB_QUEUE=0; the skip flags (-DskipTests) do not lift it.
set -euo pipefail
SELF=$(readlink -f "$0")
# --help / -h as the only argument: print this header (the usage and the rules above) to stdout, exit 0, touch nothing
if [ "$#" -eq 1 ] && { [ "$1" = --help ] || [ "$1" = -h ]; }; then sed -n '2,/^set -/{/^set -/!s/^# \{0,1\}//p;}' "$SELF"; exit 0; fi
wants_jbct() {  # the ONE copy of the jbct-run test (the helper trusts it): a jbct:* or org.pragmatica-lite:jbct-maven-plugin:* goal, or the jbct profile (-Pjbct, -P a,jbct, --activate-profiles); "!jbct" / "-jbct" do not count
  local a prof=0 p w=1
  for a in "$@"; do
    if [ "$prof" = 1 ]; then prof=0; a="-P$a"; fi
    case $a in
      jbct:*|org.pragmatica-lite:jbct-maven-plugin:*) w=0 ;;
      -P|--activate-profiles) prof=1 ;;
      -P*|--activate-profiles=*) for p in $(printf '%s' "${a#-P}" | sed 's/^--activate-profiles=//' | tr ',' ' '); do [ "$p" != jbct ] || w=0; done ;;
    esac
  done
  return $w
}
repeated_test_goal() {  # the ONE copy of the repeated-test-goal test (#132): prints the unit and the tasks of the first test-running goal the maven args name more than once; prints nothing (return 0) when none
  # UNITS: S = surefire `test`, F = failsafe `integration-test`. A task runs S when it is the goal (`surefire:test`, `org.apache.maven.plugins:maven-surefire-plugin[:<ver>]:test`, any `@<execution>`) or a lifecycle
  # phase from `test` on (test prepare-package package pre-integration-test integration-test post-integration-test verify install deploy); F likewise for `failsafe`/maven-failsafe-plugin `integration-test` and the
  # phases from `integration-test` on. An option and its separate value (-pl x, -T 2, -D k=v ...) is not a task; a plugin of another groupId, `failsafe:verify` and `x:test` of any other prefix run none.
  local a skip=0 s=0 f=0 ts="" t
  for a in "$@"; do
    if [ "$skip" = 1 ]; then skip=0; continue; fi
    case $a in
      -pl|--projects|-f|--file|-T|--threads|-P|--activate-profiles|-s|--settings|-gs|--global-settings|-rf|--resume-from|-l|--log-file|-b|--builder|-t|--toolchains|-gt|--global-toolchains|-D) skip=1; continue ;;
      -*) continue ;;
