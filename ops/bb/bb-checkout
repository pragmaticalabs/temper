#!/usr/bin/env bash
# bb-checkout <name> <sha-or-ref> -- isolated pragmatica checkout at ~/work/co/<name>, own .m2-local.
# Fetches the mirror from GitHub first, so any pushed SHA resolves. Refuses to reuse an existing dir.
# Probe commits (probes-init.sh): if ~/work/probes.git exists its refs/probes/* are fetched into the checkout as
# refs/remotes/probes/*, so <ref> may also be a SHA that exists only there or probes/<owner>/<name>. A <ref> of the form
# probes/<owner>/<name> resolves ONLY as refs/remotes/probes/<owner>/<name> in the clone (a public branch or tag of that name in
# the mirror never shadows it); any other <ref> is tried in the mirror first; a ref that resolves in neither makes the run fail and leaves no checkout dir. At most once per 24 h a best-effort
# bb-probe-reap runs afterwards; its failure never fails the checkout.
# Mirror lock (#119): the fetch, the rev-parse and the clone of the mirror run under an exclusive flock on $HOME/work/pragmatica.git.lock
# (next to the mirror, never in the queue dir), so concurrent callers queue instead of racing on ref locks ("cannot lock ref ...: is at X
# but expected Y") or on a repack under a clone. Anyone else that writes the mirror must take the same lock. The lock fd is closed in every
# child (a git child can never outlive the script holding the lock) and gc runs in the foreground (gc.autoDetach=false), inside the lock
# and inside the fetch bound; the kernel drops the lock when the script dies, kill -9 included. A caller that has to queue says so on
# stderr ("waiting for the mirror lock"). Bounds, in seconds, both overridable by a [0-9]+ environment variable:
#   BB_MIRROR_LOCK_WAIT     default 420   wait for the lock; must cover one hung holder (the fetch bound) plus one normal fetch
#   BB_MIRROR_FETCH_TIMEOUT default 300   the fetch itself (a cold fetch takes seconds to about a minute); TERM, KILL 10 s later
# Exit codes: 2 usage, 3 dir exists, 4 owner guard, 5 ref not found (existing); 6 the mirror lock was not obtained within the wait (or
# no flock/timeout on this host); 7 the mirror fetch exceeded its bound (timeout's 124, or 137 once the bound has passed; a SIGKILL
# before the bound, e.g. the OOM killer, is not an expiry and stays 137 with a line saying so). Any other fetch failure keeps git's own
# exit code. On 6 and 7 no checkout dir exists. Named limit: a git killed -9 mid-update (also our own KILL after the TERM grace) leaves
# <ref>.lock / packed-refs.lock in the mirror and every later fetch fails "Unable to create ... File exists"; on any failed fetch this
# script lists the *.lock files and the operator command (find <mirror> -name '*.lock' -type f -delete, when no git uses the mirror).
# It deletes none: the lock-less hand-run scripts that also fetch the mirror may own them. The clone under the lock is not bounded.
set -euo pipefail
[ $# -eq 2 ] || { echo "usage: bb-checkout <name> <sha-or-ref>" >&2; exit 2; }
NAME=$1; REF=$2
# Ownership guard (2026-09-27, after a cross-agent build into another agent's checkout):
# every caller declares BB_OWNER (its agent prefix, e.g. s5, v1552); a checkout belongs to the
# owner whose "<owner>-" prefix its directory name carries. No match -> refuse, before any write.
: "${BB_OWNER:?refusing: set BB_OWNER=<your agent prefix>; checkout names must start with <prefix>-}"
case "$BB_OWNER" in *[!A-Za-z0-9_]*|"") echo "refusing: BB_OWNER must be [A-Za-z0-9_]+" >&2; exit 4;; esac
case "$NAME" in "$BB_OWNER"-*) ;; *) echo "refusing: checkout name must start with $BB_OWNER-" >&2; exit 4;; esac
MIRROR=$HOME/work/pragmatica.git
CO=$HOME/work/co/$NAME
[ -e "$CO" ] && { echo "refusing: $CO exists (one dir per agent/SHA; remove it yourself if it is yours)" >&2; exit 3; }
PROBES=$HOME/work/probes.git
MADE=
# a failed run removes only the dir this run created
trap 'rc=$?; [ "$rc" = 0 ] || [ -z "$MADE" ] || rm -rf "$CO"' EXIT
LOCK_WAIT=${BB_MIRROR_LOCK_WAIT:-420}; FETCH_T=${BB_MIRROR_FETCH_TIMEOUT:-300}
case "$LOCK_WAIT$FETCH_T" in *[!0-9]*|"") echo "refusing: BB_MIRROR_LOCK_WAIT and BB_MIRROR_FETCH_TIMEOUT must be [0-9]+ seconds" >&2; exit 2;; esac
command -v flock > /dev/null 2>&1 && command -v timeout > /dev/null 2>&1 || { echo "refusing: flock and timeout are required for the mirror lock" >&2; exit 6; }
LOCK=$MIRROR.lock
exec 9>> "$LOCK" || { echo "refusing: cannot open the mirror lock $LOCK" >&2; exit 6; }
if ! flock -n 9; then
  echo "bb-checkout: waiting for the mirror lock $LOCK (up to ${LOCK_WAIT}s)" >&2
  flock -w "$LOCK_WAIT" 9 || { echo "refusing: mirror lock $LOCK not obtained within ${LOCK_WAIT}s (another fetch holds it); nothing created" >&2; exit 6; }
fi
# fd 9 is closed (9>&-) in every command below: a child must never inherit the lock
# a git killed -9 mid-update leaves <ref>.lock / packed-refs.lock in the mirror and every later fetch then fails with git's own exit code;
# nothing here deletes them (a foreign process, e.g. a hand-run fetch, may own them): they are listed with the operator's command
lock_files() {
  local f
  f=$(find "$MIRROR" -name '*.lock' -type f 2> /dev/null | head -n 20)
  [ -z "$f" ] || {
    echo "bb-checkout: lock files in the mirror, left by a git killed mid-update (none is deleted here):" >&2
    printf '%s\n' "$f" | while IFS= read -r l; do ls -ld "$l" >&2; done
    echo "bb-checkout: if no git process uses $MIRROR, remove them: find $MIRROR -name '*.lock' -type f -delete" >&2
  }
}
rc=0; t0=$SECONDS
timeout -k 10 "$FETCH_T" git -c gc.autoDetach=false -C "$MIRROR" fetch -q --prune origin 9>&- || rc=$?
expired=
case $rc in
  0) ;;
  124) expired=1 ;;   # timeout's own status: it sent TERM at the bound
  137) # KILL: ours after the TERM grace (the bound has passed), or an outside SIGKILL (OOM killer) well before it
    [ $((SECONDS - t0)) -lt "$FETCH_T" ] || expired=1 ;;
esac
if [ -n "$expired" ]; then
  echo "refusing: the mirror fetch exceeded ${FETCH_T}s (BB_MIRROR_FETCH_TIMEOUT); nothing created" >&2; lock_files; exit 7
elif [ "$rc" != 0 ]; then
  [ "$rc" != 137 ] || echo "bb-checkout: the mirror fetch was killed by SIGKILL after $((SECONDS - t0))s, before its ${FETCH_T}s bound (an outside kill, e.g. the OOM killer): not a bound expiry" >&2
  lock_files; exit "$rc"
fi
PROBE_REF=
case $REF in probes/*/*) PROBE_REF=$REF ;; esac
SHA=
[ -n "$PROBE_REF" ] || SHA=$(git -C "$MIRROR" rev-parse --verify "$REF^{commit}" 2> /dev/null 9>&-) || SHA=
[ -n "$SHA" ] || [ -d "$PROBES" ] || { echo "refusing: $REF is not in the mirror (and there is no $PROBES)" >&2; exit 5; }
mkdir -p "$HOME/work/co"
git clone -q --no-checkout "$MIRROR" "$CO" 9>&-
MADE=1
exec 9>&-   # the mirror is no longer read: release the lock before the probes steps
if [ -d "$PROBES" ]; then
  git -C "$CO" remote add probes "$PROBES"
  if ! git -C "$CO" fetch -q probes '+refs/probes/*:refs/remotes/probes/*'; then
    [ -n "$SHA" ] || { echo "refusing: $REF is not in the mirror and fetching $PROBES failed" >&2; exit 5; }
    echo "warning: fetching $PROBES failed; continuing with the mirror's $REF" >&2
  fi
fi
if [ -z "$SHA" ]; then
  FULL=$REF; [ -z "$PROBE_REF" ] || FULL=refs/remotes/$PROBE_REF
  SHA=$(git -C "$CO" rev-parse --verify "$FULL^{commit}" 2> /dev/null) \
    || { echo "refusing: $REF resolves neither in the mirror nor in $PROBES (nothing created)" >&2; exit 5; }
fi
git -C "$CO" checkout -q --detach "$SHA"
printf '%s\n' '-T 1C' '--no-transfer-progress' "-Dmaven.repo.local=$CO/.m2-local" > "$CO/.mvn/maven.config"
git -C "$CO" update-index --skip-worktree .mvn/maven.config
printf '%s\n' /.bb/ /.m2-local/ >> "$CO/.git/info/exclude"
# Seed third-party deps by COPY (not hardlink: install would write through a link into the seed).
if [ -d "$HOME/work/m2-seed" ]; then cp -a "$HOME/work/m2-seed" "$CO/.m2-local"; fi
echo "checkout=$CO sha=$SHA"
cat "$CO/.mvn/maven.config"
# Best-effort probes reaper, at most once per 24 h per host (stamp is touched first: a failing reaper is not retried per checkout).
REAP=$(dirname "$0")/bb-probe-reap
STAMP=$HOME/work/.probes-reap.stamp
if [ -d "$PROBES" ] && [ -x "$REAP" ] && { [ ! -e "$STAMP" ] || [ -n "$(find "$STAMP" -mmin +1440 2> /dev/null)" ]; }; then
  touch "$STAMP" 2> /dev/null || true
  "$REAP" >&2 || echo "warning: bb-probe-reap failed (ignored)" >&2
fi
