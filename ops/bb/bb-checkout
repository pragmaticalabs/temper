#!/usr/bin/env bash
# bb-checkout <name> <sha-or-ref> -- isolated pragmatica checkout at ~/work/co/<name>, own .m2-local.
# Fetches the mirror from GitHub first, so any pushed SHA resolves. Refuses to reuse an existing dir.
set -euo pipefail
[ $# -eq 2 ] || { echo "usage: bb-checkout <name> <sha-or-ref>" >&2; exit 2; }
NAME=$1; REF=$2
# Ownership guard (2026-09-27, after a cross-agent build into another agent's checkout):
# every caller declares BB_OWNER (its agent prefix, e.g. s5, v1552); a checkout belongs to the
# owner whose "<owner>-" prefix its directory name carries. No match -> refuse, before any write.
: "${BB_OWNER:?refusing: set BB_OWNER=<your agent prefix>; checkout names must start with <prefix>-}"
case "$BB_OWNER" in *[!A-Za-z0-9_]*|"") echo "refusing: BB_OWNER must be [A-Za-z0-9_]+" >&2; exit 4;; esac
case "$NAME" in "$BB_OWNER"-*) ;; *) echo "refusing: checkout name must start with $BB_OWNER-" >&2; exit 4;; esac
MIRROR=$HOME/work/pragmatica.git
CO=$HOME/work/co/$NAME
[ -e "$CO" ] && { echo "refusing: $CO exists (one dir per agent/SHA; remove it yourself if it is yours)" >&2; exit 3; }
git -C "$MIRROR" fetch -q --prune origin
SHA=$(git -C "$MIRROR" rev-parse --verify "$REF^{commit}")
mkdir -p "$HOME/work/co"
git clone -q --no-checkout "$MIRROR" "$CO"
git -C "$CO" checkout -q --detach "$SHA"
printf '%s\n' '-T 1C' '--no-transfer-progress' "-Dmaven.repo.local=$CO/.m2-local" > "$CO/.mvn/maven.config"
git -C "$CO" update-index --skip-worktree .mvn/maven.config
printf '%s\n' /.bb/ /.m2-local/ >> "$CO/.git/info/exclude"
# Seed third-party deps by COPY (not hardlink: install would write through a link into the seed).
if [ -d "$HOME/work/m2-seed" ]; then cp -a "$HOME/work/m2-seed" "$CO/.m2-local"; fi
echo "checkout=$CO sha=$SHA"
cat "$CO/.mvn/maven.config"
