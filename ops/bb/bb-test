#!/usr/bin/env bash
# bb-test <checkout-dir> <module> <Class[#method]>... [--repeat N]   (bb-test lane, design §2/§3)
# Re-runs selected tests of ONE module without a maven pass: the JUnit Platform Console Launcher on
# <module>/target/test-classes:<module>/target/classes:<cp recorded by the last green bb-build (.bb/cp/<module>.cp)>, with
# -Daether.requireDocker=true. The launch is ONE queue ticket (cap, port group, netns slot, memory floor, load gate as for a build),
# enqueued through bb-build (BB_LAUNCH makes the waiter run this script's __launch mode instead of maven), and NEVER deduped.
# VERDICT = the java exit status (the ticket's rc, read with bb-wait/bb-await as for a build), unless the resolved junit check below refuses
# the run (rc 15, which replaces it). --fail-if-no-tests: a selection that
# matches nothing is red (java exit 2). Reports: <module>/target/bb-test-reports/<ticket>/ (with --repeat N>1: .../run<i>/), the
# launcher's legacy XML, never surefire-reports; java's console and a count line (bb-testcount) per run are appended to .bb/build.log
# after the last run, once the resolved junit check passed.
# STALE-JAR GUARD (rc 12, nothing queued; run again at launch, after any queue wait): bb-cp-record check. BB_STALE_OK (any value) is
# refused. LAUNCHER: junit-platform-console-standalone 1.13.4, sha256-pinned, read from the host seed
# (~/work/temper-m2-seed/org/junit/platform/...); absent or wrong sha = rc 14, the path and sha named; nothing is installed here.
# RESOLVED JUNIT CHECK (rc 15; CTO ruling on vbt5/vbt6, temper#72): AFTER the java run, every jar on the run's own test classpath (the
# --class-path java got: test-classes, classes and .bb/cp/<module>.cp, which is maven's dependency:build-classpath of the build, with the
# build's own options) that holds org/junit/platform/, org/junit/jupiter/ or org/junit/vintage/ classes is read: its MANIFEST.MF names it
# (Implementation-Title, else Bundle-SymbolicName) and gives its version (Implementation-Version, else Bundle-Version). A platform jar must be
# LAUNCHER_VERSION 1.N.P, a jupiter or vintage jar 5.N.P. FAIL CLOSED: no such jar on the classpath, a jar that cannot be read, a classpath
# .jar that does not exist, a junit jar whose name or version the manifest does not give, a classpath directory holding org/junit/
# {platform,jupiter,vintage}/ (no manifest versions it) = refused; a missing non-.jar entry (an absent target/classes) holds nothing and is skipped. No build config is parsed for it.
# BEFORE the run (vbt7 F2, never hang): a classpath entry that exists but is neither a regular file nor a directory (a FIFO, a device, or a
# symlink resolving to one) is refused the same way (rc 15), java not run: java would block opening it.
# A REFUSAL REPLACES THE VERDICT: rc 15 (the ticket's rc=, so .bb/rc), the ticket gets refused=<reason naming the resolved versions> and
# verdict_source=guard (never verdict_source=java), .bb/refused holds the same reason, the ticket log's state column reads refused, bb-result
# prints it; the run's console output and per-run count lines are not printed, and its report dir is renamed <ticket>.refused.
# VERDICT SOURCE (vbt4 L2): the launch writes verdict_source=guard (a launch-time guard refused: rc 12/14/15) or verdict_source=java (java
# ran and the resolved check passed; rc = its exit status) on the ticket, so a java System.exit(12|14|15) never reads as a guard.
# Call rc: 0 queued (as bb-build); 2 usage; 12 stale-jar guard; 14 launcher jar absent/not the pin; others from bb-build (3, 4).
# Ticket rc 15: the run's resolved junit is not the launcher's (refused, above).
# REQUIRE DOCKER (CTO ruling 2026-11-19): the launch runs with -Daether.requireDocker=true (bb-build appends it to every ticket's args) unless
# BB_REQUIRE_DOCKER=0 is given at enqueue: the same explicit override as bb-build (#31), recorded in the ticket as requireDocker=0 (bb-tickets shows it). On condition (CTO): the ticket (requireDockerEffective=true|false) AND each result line
# (requireDocker=true|false) state it, so a count with Testcontainers skipped never passes for a full one.
# Mutation flow (§3) and BB_LOAD (§4) are not implemented here.
set -euo pipefail
SELF=$(readlink -f "$0"); HERE=$(dirname "$SELF")
LAUNCHER_VERSION=1.13.4
LAUNCHER_SHA=${BB_TEST_LAUNCHER_SHA:-3fdfc37e29744a9a67dd5365e81467e26fbde0b7aa204e6f8bbe79eeaa7ae892}
LAUNCHER_JAR=${BB_TEST_LAUNCHER_JAR:-$HOME/work/temper-m2-seed/org/junit/platform/junit-platform-console-standalone/$LAUNCHER_VERSION/junit-platform-console-standalone-$LAUNCHER_VERSION.jar}
SEL_RE='^[A-Za-z_$][A-Za-z0-9_.$]*(#[A-Za-z_$][A-Za-z0-9_$]*)?$'

sha256_of() { if command -v sha256sum > /dev/null; then sha256sum "$1"; else shasum -a 256 "$1"; fi | cut -d' ' -f1; }
launcher_ok() {
  [ -f "$LAUNCHER_JAR" ] && [ "$(sha256_of "$LAUNCHER_JAR")" = "$LAUNCHER_SHA" ] && return 0
  echo "bb-test: launcher jar missing or not the pin (rc 14): expected $LAUNCHER_JAR with sha256 $LAUNCHER_SHA (junit-platform-console-standalone $LAUNCHER_VERSION); add it to the host seed, nothing is installed by bb-test" >&2
  return 14
}

resolved_junit() {  # <classpath>: "v <jars>" when every junit jar on it is the launcher's version, else "x <why>" (fail closed)
  python3 -I - "$LAUNCHER_VERSION" "$1" 2> /dev/null <<'PY' || echo "x the read of the classpath's junit jars failed"
import os, re, sys, zipfile
plat = sys.argv[1]
jup = '5.' + plat.split('.', 1)[1]
def no(why):
    print('x ' + why)
    sys.exit(0)
def manifest(z):
    attrs, key = {}, None
    for ln in z.read('META-INF/MANIFEST.MF').decode('utf-8', 'replace').splitlines():
        if ln.startswith(' ') and key:
            attrs[key] += ln[1:]
        elif ':' in ln:
            key, val = ln.split(':', 1)
            attrs[key] = val.strip()
    return attrs
seen, bad = [], []
for e in sys.argv[2].split(':'):
    if not e:
        continue
    if os.path.isdir(e):
        if any(os.path.isdir(os.path.join(e, 'org', 'junit', p)) for p in ('platform', 'jupiter', 'vintage')):
            no('the classpath directory %s holds junit classes, which no manifest versions' % e)
        continue
    if not os.path.isfile(e):
        if e.endswith('.jar'):
            no('the classpath jar %s does not exist' % e)
        continue
    try:
        with zipfile.ZipFile(e) as z:
            if not any(n.startswith(('org/junit/platform/', 'org/junit/jupiter/', 'org/junit/vintage/')) for n in z.namelist()):
                continue
            m = manifest(z)
    except Exception as ex:
        no('the classpath entry %s cannot be read as a jar (%s)' % (e, type(ex).__name__))
    name = m.get('Implementation-Title') or m.get('Bundle-SymbolicName') or ''
    ver = m.get('Implementation-Version') or m.get('Bundle-Version') or ''
    want = jup if re.search('jupiter|vintage', name) else plat if 'platform' in name else None
    if want is None or not ver:
        no('the junit jar %s has no junit name or no version in its manifest' % e)
    seen.append('%s %s' % (name, ver))
    if ver != want:
        bad.append('%s %s (launcher wants %s)' % (name, ver, want))
if bad:
    no('resolved ' + ', '.join(bad[:6]) + (' +%d more' % (len(bad) - 6) if len(bad) > 6 else ''))
if not seen:
    no('no junit-platform, jupiter or vintage jar on the test classpath')
print('v ' + ', '.join(sorted(set(seen))))
PY
}

if [ "${1:-}" = __launch ]; then
  # ---- the queue ticket's job: runs where maven would, in the checkout. args: <module> <repeat> <selector>... [-D...] ----
  shift
  CO=$(pwd); MOD=$1; REPEAT=$2; shift 2
  . "$HERE/bb-queue-lib.sh"
  TICKET=""; N=0
  for f in "$Q"/running/*; do [ -f "$f" ] && [ "$(field "$f" co)" = "$CO" ] && { TICKET=${f##*/}; N=$((N + 1)); }; done
  [ "$N" = 1 ] || { echo "bb-test: cannot name this run's ticket ($N running tickets for $CO)" >&2; exit 1; }
  # verdict_source (vbt4 L2): rc 12/14/15 from a guard and the same number from java are told apart on the ticket, not by the number.
  source_is() { ( flock 9; [ ! -f "$Q/running/$TICKET" ] || echo "verdict_source=$1" >> "$Q/running/$TICKET" ) 9> "$Q/.lock"; }
  guard() { "$@" && return 0; local r=$?; source_is guard; exit "$r"; }
  refuse() {   # rc 15: the refusal replaces the verdict on every surface (header: RESOLVED JUNIT CHECK)
    local why=${1//[$'\n\r']/ }
    ( flock 9; [ ! -f "$Q/running/$TICKET" ] || printf 'refused=%s\nverdict_source=guard\n' "$why" >> "$Q/running/$TICKET" ) 9> "$Q/.lock"
    printf '%s\n' "$why" > "$CO/.bb/refused"
    if [ -z "$OUT" ]; then echo "bb-test: REFUSED (rc 15): $why; java was not run"; exit 15; fi
    rm -rf "$BASE.refused"; mv "$BASE" "$BASE.refused"; mv "$OUT" "$BASE.refused/console.txt"
    echo "bb-test: REFUSED (rc 15): $why; this run's test outcome is not a verdict (kept in $BASE.refused)"
    exit 15
  }
  JVM=(); SELS=()
  for a in "$@"; do
    case "$a" in
      -D*) JVM+=("$a");;
      *#*) SELS+=(--select-method "$a");;
      *) SELS+=(--select-class "$a");;
    esac
  done
  guard "$HERE/bb-cp-record" check "$CO" "$MOD"
  guard launcher_ok
  JAVA=${BB_TEST_JAVA:-${JAVA_HOME:-/usr/lib/jvm/java-25-openjdk-amd64}/bin/java}
  CP="$CO/$MOD/target/test-classes:$CO/$MOD/target/classes:$(cat "$CO/.bb/cp/${MOD//\//__}.cp")"
  # vbt7 F2 (fail closed, never hang): java opens every classpath entry, so a FIFO or device entry (or a symlink to one) would block it
  # before the resolved check is ever reached. Such an entry is refused here, before java runs.
  OUT=
  IFS=: read -r -a CPE <<< "$CP"
  for e in ${CPE[@]+"${CPE[@]}"}; do
    if [ -e "$e" ] && [ ! -f "$e" ] && [ ! -d "$e" ]; then
      refuse "unreadable classpath entry: $e is a $(stat -L -c %F -- "$e" 2> /dev/null || echo 'special file'), not a regular file or directory"
    fi
  done
  RC=0; RD=false
  for j in ${JVM[@]+"${JVM[@]}"}; do [ "$j" != -Daether.requireDocker=true ] || RD=true; done
  BASE=$CO/$MOD/target/bb-test-reports/$TICKET; mkdir -p "$BASE"
  OUT=$(mktemp "$CO/.bb/bb-test-out.XXXXXX")   # java's console and the count lines are printed only once the resolved check passed
  for i in $(seq "$REPEAT"); do
    D=$BASE; [ "$REPEAT" = 1 ] || D=$D/run$i
    mkdir -p "$D"
    set +e
    (cd "$CO/$MOD" && "$JAVA" ${JVM[@]+"${JVM[@]}"} -jar "$LAUNCHER_JAR" execute --disable-banner --fail-if-no-tests \
        --class-path "$CP" --reports-dir "$D" "${SELS[@]}") >> "$OUT" 2>&1
    r=$?
    set -e
    echo "bb-test: run $i/$REPEAT java exit $r; requireDocker=$RD; $("$HERE/bb-testcount" "$D" 2>&1 | tr '\n' ' ')" >> "$OUT"
    [ "$r" -le "$RC" ] || RC=$r
  done
  JUNIT=$(resolved_junit "$CP")
  [ "${JUNIT%% *}" = v ] || refuse "junit version: ${JUNIT#x }; the launcher is junit-platform $LAUNCHER_VERSION"
  source_is java
  cat "$OUT"; rm -f "$OUT"
  echo "bb-test: resolved junit on the test classpath: ${JUNIT#v }"
  exit "$RC"
fi

[ $# -ge 3 ] || { echo "usage: bb-test <checkout> <module> <Class[#method]>... [--repeat N]" >&2; exit 2; }
if [ -n "${BB_STALE_OK+x}" ]; then
  echo "bb-test: BB_STALE_OK is refused (rc 12); the only way past a stale-jar refusal is a rebuild (bb-build)" >&2; exit 12
fi
CO=$1; MOD=${2%/}; shift 2
[ -d "$CO" ] || { echo "bb-test: no such checkout: $CO" >&2; exit 2; }
CO=$(cd "$CO" && pwd)
[[ $MOD =~ ^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$ ]] && [[ $MOD != *..* ]] || { echo "bb-test: module must be a relative path below the checkout: $MOD" >&2; exit 2; }
REPEAT=1; SELS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --repeat) [[ ${2:-} =~ ^[1-9][0-9]?$ ]] || { echo "bb-test: --repeat needs 1..99" >&2; exit 2; }; REPEAT=$2; shift 2;;
    *) [[ $1 =~ $SEL_RE ]] || { echo "bb-test: not a Class[#method] selector: $1" >&2; exit 2; }; SELS+=("$1"); shift;;
  esac
done
[ ${#SELS[@]} -gt 0 ] || { echo "usage: bb-test <checkout> <module> <Class[#method]>... [--repeat N]" >&2; exit 2; }
"$HERE/bb-cp-record" check "$CO" "$MOD" || exit $?
launcher_ok || exit $?
. "$HERE/bb-queue-lib.sh"
GROUP=${BB_PORT_GROUP:-}
if [ -z "$GROUP" ]; then
  GROUP=$(python3 "$HERE/bb-portgroup.py" "$PGM" "$CO" -pl "$MOD" test 2> /dev/null) || GROUP="1 classifier failed"
  GROUP=${GROUP%% *}; case "$GROUP" in 0|1) ;; *) GROUP=1;; esac
fi
BB_LAUNCH=$SELF BB_NO_CP_RECORD=1 BB_DEDUP=0 BB_PORT_GROUP=$GROUP exec "$HERE/bb-build" "$CO" __launch "$MOD" "$REPEAT" "${SELS[@]}"
