#!/usr/bin/env bash
# bb-test <checkout-dir> <module> <Class[#method]>... [--repeat N]   (bb-test lane, design §2/§3)
# Re-runs selected tests of ONE module without a maven pass: the JUnit Platform Console Launcher on
# <module>/target/test-classes:<module>/target/classes:<cp recorded by the last green bb-build (.bb/cp/<module>.cp)>, with
# -Daether.requireDocker=true. The launch is ONE queue ticket (cap, port group, netns slot, memory floor, load gate as for a build),
# enqueued through bb-build (BB_LAUNCH makes the waiter run this script's __launch mode instead of maven), and NEVER deduped.
# VERDICT = the java exit status (the ticket's rc, read with bb-wait/bb-await as for a build). --fail-if-no-tests: a selection that
# matches nothing is red (java exit 2). Reports: <module>/target/bb-test-reports/<ticket>/ (with --repeat N>1: .../run<i>/), the
# launcher's legacy XML, never surefire-reports; a count line (bb-testcount) is appended to .bb/build.log after each run.
# STALE-JAR GUARD (rc 12, nothing queued; run again at launch, after any queue wait): bb-cp-record check. BB_STALE_OK (any value) is
# refused. LAUNCHER: junit-platform-console-standalone 1.13.4, sha256-pinned, read from the host seed
# (~/work/temper-m2-seed/org/junit/platform/...); absent or wrong sha = rc 14, the path and sha named; nothing is installed here.
# VERSION GUARD (rc 15, checked with the launcher, at enqueue and at launch): the junit-platform version the checkout builds against,
# read from /project/properties of its root pom.xml by an XML parse (comments and plugin config are never read for it): exactly one literal
# <junit-platform.version>, else exactly one literal <junit.version> 5.N.P read as platform 1.N.P, must equal LAUNCHER_VERSION. A different version = rc 15
# naming both; anything else (no property, two definitions, a ${ref}, a -SNAPSHOT or other non-literal, a 6.x junit.version, an unparsable pom) = rc 15, fail closed,
# "cannot be determined". Every override of either property also = rc 15: a <profile> (root pom or a pom on the module path or <parent> chain),
# such a pom's own properties, a <parent> outside the checkout, a literal org.junit* dependency version (a junit-bom import included), two
# <properties> blocks, a mention in .mvn/maven.config (-D or --define=), a -D in the launch args (vbt4 M1, vbt5 H1).
# VERDICT SOURCE (vbt4 L2): the launch writes verdict_source=guard (a launch-time guard refused: rc 12/14/15) or verdict_source=java (java
# ran; rc = its exit status) on the ticket, so a java System.exit(12|14|15) never reads as a guard.
# Call rc: 0 queued (as bb-build); 2 usage; 12 stale-jar guard; 14 launcher jar absent/not the pin; 15 checkout's junit-platform version differs from
# the launcher's or is undeterminable; others from bb-build (3, 4).
# REQUIRE DOCKER (CTO ruling 2026-11-19): the launch runs with -Daether.requireDocker=true (bb-build appends it to every ticket's args) unless
# BB_REQUIRE_DOCKER=0 is given at enqueue: the same explicit override as bb-build (#31), recorded in the ticket as requireDocker=0 (bb-tickets shows it). On condition (CTO): the ticket (requireDockerEffective=true|false) AND each result line
# (requireDocker=true|false) state it, so a count with Testcontainers skipped never passes for a full one.
# Mutation flow (§3) and BB_LOAD (§4) are not implemented here.
set -euo pipefail
SELF=$(readlink -f "$0"); HERE=$(dirname "$SELF")
LAUNCHER_VERSION=1.13.4
LAUNCHER_SHA=${BB_TEST_LAUNCHER_SHA:-3fdfc37e29744a9a67dd5365e81467e26fbde0b7aa204e6f8bbe79eeaa7ae892}
LAUNCHER_JAR=${BB_TEST_LAUNCHER_JAR:-$HOME/work/temper-m2-seed/org/junit/platform/junit-platform-console-standalone/$LAUNCHER_VERSION/junit-platform-console-standalone-$LAUNCHER_VERSION.jar}
SEL_RE='^[A-Za-z_$][A-Za-z0-9_.$]*(#[A-Za-z_$][A-Za-z0-9_$]*)?$'

sha256_of() { if command -v sha256sum > /dev/null; then sha256sum "$1"; else shasum -a 256 "$1"; fi | cut -d' ' -f1; }
launcher_ok() {
  [ -f "$LAUNCHER_JAR" ] && [ "$(sha256_of "$LAUNCHER_JAR")" = "$LAUNCHER_SHA" ] && return 0
  echo "bb-test: launcher jar missing or not the pin (rc 14): expected $LAUNCHER_JAR with sha256 $LAUNCHER_SHA (junit-platform-console-standalone $LAUNCHER_VERSION); add it to the host seed, nothing is installed by bb-test" >&2
  return 14
}

platform_version_of() {  # <checkout> <module>: "v <version>" its root pom pins, or "x <why it cannot be determined>" (fail closed)
  python3 -I - "$1" "$2" 2> /dev/null <<'PY' || echo "x the version parse failed"
import os, re, sys, xml.etree.ElementTree as ET
# /project/properties of the root pom only (comments and plugin config are never read for the value). Exactly one literal
# <junit-platform.version>, else (none at all) exactly one literal <junit.version> 5.N.P read as platform 1.N.P. Fail closed (rc 15) on:
# two <properties> blocks, two definitions, a ${ref}, a non-literal or a 6.x; and on every OVERRIDE of either property (vbt4 M1, vbt5 H1):
# a <profile>'s properties in the root pom or in any pom from the root down to the module or on the module's local <parent> chain, such
# a pom's own properties, a <parent> that is not a pom in the checkout, an org.junit* <dependency> anywhere in those poms or the root pom
# (dependencyManagement, a junit-bom import, plugin dependencies) whose version is set but is not ${junit.version} or
# ${junit-platform.version}, and any mention of either name in .mvn/maven.config (-D, -D name, --define=name). The launch-time -D
# args are checked by the caller (jvm_args_ok).
NAMES = ('junit-platform.version', 'junit.version')
co, module = sys.argv[1], sys.argv[2].strip('/')
local = lambda t: t.rsplit('}', 1)[-1] if isinstance(t, str) else ''
def no(why):
    print('x ' + why)
    sys.exit(0)
def project(path):
    try:
        root = ET.parse(path).getroot()
    except Exception:
        no('%s does not parse' % os.path.relpath(path, co))
    if local(root.tag) != 'project':
        no('%s is not a <project>' % os.path.relpath(path, co))
    return root
def defines(props):
    return [local(c.tag) for p in props for c in p if local(c.tag) in NAMES]
def profile_props(root):
    return [p for prof in root.iter() if local(prof.tag) == 'profile' for p in prof if local(p.tag) == 'properties']
if not os.path.isfile(os.path.join(co, 'pom.xml')):
    no('no root pom.xml')
root = project(os.path.join(co, 'pom.xml'))
props = [c for c in root if local(c.tag) == 'properties']
if len(props) > 1:
    no('the root pom has %d <properties> blocks' % len(props))
for name in defines(profile_props(root)):
    no('a <profile> in the root pom sets <%s>' % name)
REFS = ('${junit-platform.version}', '${junit.version}')
child = lambda e, tag: next((c for c in e if local(c.tag) == tag), None)
text = lambda e, tag: None if child(e, tag) is None else (child(e, tag).text or '').strip()
def junit_literals(path, proj):  # any org.junit* <dependency> (incl. a dependencyManagement import of junit-bom) whose version is set but is not a REF
    for dep in proj.iter():
        if local(dep.tag) == 'dependency' and (text(dep, 'groupId') or '').startswith('org.junit') and text(dep, 'version') not in (None,) + REFS:
            no('%s sets the version of %s:%s to %s, not to a junit version property' % (os.path.relpath(path, co), text(dep, 'groupId'), text(dep, 'artifactId'), text(dep, 'version')))
def overrides(path, proj):
    for name in defines([c for c in proj if local(c.tag) == 'properties'] + profile_props(proj)):
        no('%s sets <%s>' % (os.path.relpath(path, co), name))
    junit_literals(path, proj)
junit_literals(os.path.join(co, 'pom.xml'), root)
rootpom = os.path.realpath(os.path.join(co, 'pom.xml'))
d = co
for part in module.split('/'):
    d = os.path.join(d, part)
    pom = os.path.join(d, 'pom.xml')
    if os.path.isfile(pom) and os.path.realpath(pom) != rootpom:
        overrides(pom, project(pom))
# the module's <parent> chain (vbt5 H1-ii): a parent found by relativePath off the module's dir path is an inherited override too.
# Followed until it reaches the root pom or a pom without <parent>; a parent that is not a pom in the checkout (empty relativePath,
# no file there, another artifactId: maven then resolves it from a repository) = fail closed.
pom = os.path.join(co, module, 'pom.xml')
for _ in range(64):
    if not os.path.isfile(pom) or os.path.realpath(pom) == rootpom:
        break
    par = child(project(pom), 'parent')
    if par is None:
        break
    rel = text(par, 'relativePath')
    nxt = os.path.normpath(os.path.join(os.path.dirname(pom), '../pom.xml' if rel is None else rel))
    if os.path.isdir(nxt):
        nxt = os.path.join(nxt, 'pom.xml')
    real = os.path.realpath(nxt)
    if rel == '' or not os.path.isfile(nxt) or not real.startswith(os.path.realpath(co) + os.sep):
        no('%s has a <parent> that is not a pom in the checkout' % os.path.relpath(pom, co))
    if text(project(nxt), 'artifactId') != text(par, 'artifactId'):
        no('%s has a <parent> %s that %s is not' % (os.path.relpath(pom, co), text(par, 'artifactId'), os.path.relpath(nxt, co)))
    if real != rootpom:
        overrides(nxt, project(nxt))
    pom = nxt
else:
    no('the <parent> chain of %s/pom.xml does not end' % module)
try:
    cfg = open(os.path.join(co, '.mvn', 'maven.config'), encoding='utf-8', errors='replace').read()
except OSError:
    cfg = ''
for name in NAMES:
    if re.search(r'(?<![A-Za-z0-9_.-])' + re.escape(name) + r'(?![A-Za-z0-9_.-])', cfg):  # any mention: -D, -D name, --define=name (vbt5 H1-i)
        no('.mvn/maven.config sets -D%s' % name)
vals = lambda name: [(c.text or '').strip() for p in props for c in p if local(c.tag) == name]
plat, junit = vals('junit-platform.version'), vals('junit.version')
if plat:
    if len(plat) == 1 and re.fullmatch(r'[0-9]+\.[0-9]+\.[0-9]+', plat[0]):
        print('v ' + plat[0])
    else:
        no('<junit-platform.version> is not exactly one literal N.N.N')
elif len(junit) == 1 and re.fullmatch(r'5\.[0-9]+\.[0-9]+', junit[0]):
    print('v 1.' + junit[0].split('.', 1)[1])
else:
    no('no literal <junit-platform.version>, nor exactly one literal <junit.version> 5.N.P, in its root pom.xml')
PY
  return 0
}
version_ok() {  # <checkout> <module>
  local v; v=$(platform_version_of "$1" "$2")
  case "$v" in
    "v $LAUNCHER_VERSION") return 0;;
    "v "*) echo "bb-test: the checkout's junit-platform version is ${v#v } but the launcher is $LAUNCHER_VERSION (rc 15); refusing: a launcher of another version can run the tests differently from maven" >&2;;
    *) echo "bb-test: the junit-platform version of $1 cannot be determined (rc 15): ${v#x }; refusing, the launcher is $LAUNCHER_VERSION" >&2;;
  esac
  return 15
}
# jvm_args_ok <arg>...: a launch-time -D of either version property is an override the pom check cannot see (rc 15).
jvm_args_ok() {
  local a; for a in "$@"; do
    case "$a" in -Djunit-platform.version|-Djunit-platform.version=*|-Djunit.version|-Djunit.version=*)
      echo "bb-test: the launch args set ${a%%=*} (rc 15); refusing: an override of the junit-platform version is not checked against the launcher" >&2; return 15;;
    esac
  done
}

if [ "${1:-}" = __launch ]; then
  # ---- the queue ticket's job: runs where maven would, in the checkout. args: <module> <repeat> <selector>... [-D...] ----
  shift
  CO=$(pwd); MOD=$1; REPEAT=$2; shift 2
  . "$HERE/bb-queue-lib.sh"
  TICKET=""; N=0
  for f in "$Q"/running/*; do [ -f "$f" ] && [ "$(field "$f" co)" = "$CO" ] && { TICKET=${f##*/}; N=$((N + 1)); }; done
  [ "$N" = 1 ] || { echo "bb-test: cannot name this run's ticket ($N running tickets for $CO)" >&2; exit 1; }
  # verdict_source (vbt4 L2): rc 12/14/15 from a guard and the same number from java are told apart on the ticket, not by the number.
  source_is() { ( flock 9; [ ! -f "$Q/running/$TICKET" ] || echo "verdict_source=$1" >> "$Q/running/$TICKET" ) 9> "$Q/.lock"; }
  guard() { "$@" && return 0; local r=$?; source_is guard; exit "$r"; }
  JVM=(); SELS=()
  for a in "$@"; do
    case "$a" in
      -D*) JVM+=("$a");;
      *#*) SELS+=(--select-method "$a");;
      *) SELS+=(--select-class "$a");;
    esac
  done
  guard "$HERE/bb-cp-record" check "$CO" "$MOD"
  guard version_ok "$CO" "$MOD"
  guard jvm_args_ok ${JVM[@]+"${JVM[@]}"}
  guard launcher_ok
  source_is java
  JAVA=${BB_TEST_JAVA:-${JAVA_HOME:-/usr/lib/jvm/java-25-openjdk-amd64}/bin/java}
  CP="$CO/$MOD/target/test-classes:$CO/$MOD/target/classes:$(cat "$CO/.bb/cp/${MOD//\//__}.cp")"
  RC=0; RD=false
  for j in ${JVM[@]+"${JVM[@]}"}; do [ "$j" != -Daether.requireDocker=true ] || RD=true; done
  for i in $(seq "$REPEAT"); do
    D=$CO/$MOD/target/bb-test-reports/$TICKET; [ "$REPEAT" = 1 ] || D=$D/run$i
    mkdir -p "$D"
    set +e
    (cd "$CO/$MOD" && "$JAVA" ${JVM[@]+"${JVM[@]}"} -jar "$LAUNCHER_JAR" execute --disable-banner --fail-if-no-tests \
        --class-path "$CP" --reports-dir "$D" "${SELS[@]}")
    r=$?
    set -e
    echo "bb-test: run $i/$REPEAT java exit $r; requireDocker=$RD; $("$HERE/bb-testcount" "$D" 2>&1 | tr '\n' ' ')"
    [ "$r" -le "$RC" ] || RC=$r
  done
  exit "$RC"
fi

[ $# -ge 3 ] || { echo "usage: bb-test <checkout> <module> <Class[#method]>... [--repeat N]" >&2; exit 2; }
if [ -n "${BB_STALE_OK+x}" ]; then
  echo "bb-test: BB_STALE_OK is refused (rc 12); the only way past a stale-jar refusal is a rebuild (bb-build)" >&2; exit 12
fi
CO=$1; MOD=${2%/}; shift 2
[ -d "$CO" ] || { echo "bb-test: no such checkout: $CO" >&2; exit 2; }
CO=$(cd "$CO" && pwd)
[[ $MOD =~ ^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$ ]] && [[ $MOD != *..* ]] || { echo "bb-test: module must be a relative path below the checkout: $MOD" >&2; exit 2; }
REPEAT=1; SELS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --repeat) [[ ${2:-} =~ ^[1-9][0-9]?$ ]] || { echo "bb-test: --repeat needs 1..99" >&2; exit 2; }; REPEAT=$2; shift 2;;
    *) [[ $1 =~ $SEL_RE ]] || { echo "bb-test: not a Class[#method] selector: $1" >&2; exit 2; }; SELS+=("$1"); shift;;
  esac
done
[ ${#SELS[@]} -gt 0 ] || { echo "usage: bb-test <checkout> <module> <Class[#method]>... [--repeat N]" >&2; exit 2; }
"$HERE/bb-cp-record" check "$CO" "$MOD" || exit $?
version_ok "$CO" "$MOD" || exit $?
launcher_ok || exit $?
. "$HERE/bb-queue-lib.sh"
GROUP=${BB_PORT_GROUP:-}
if [ -z "$GROUP" ]; then
  GROUP=$(python3 "$HERE/bb-portgroup.py" "$PGM" "$CO" -pl "$MOD" test 2> /dev/null) || GROUP="1 classifier failed"
  GROUP=${GROUP%% *}; case "$GROUP" in 0|1) ;; *) GROUP=1;; esac
fi
BB_LAUNCH=$SELF BB_NO_CP_RECORD=1 BB_DEDUP=0 BB_PORT_GROUP=$GROUP exec "$HERE/bb-build" "$CO" __launch "$MOD" "$REPEAT" "${SELS[@]}"
