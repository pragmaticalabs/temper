#!/usr/bin/env bash
# bb-hold <owner> <prio> --container <name> -- <argv...>   (2026-10-13, for temper)
# Lets a job that is not a maven build (a docker container) hold the PORT GROUP through the normal bb-* queue:
#  1. ENQUEUE a [port-group] ticket for <owner> through bb-queue-lib.sh, under the same flock as bb-build. The ticket has
#     group=1 and cap=5 (bb-build's default cap, as for a root build). <prio> is ADVISORY: it must be an integer and is
#     recorded as requested_prio=, but the grant order uses ~/work/priorities by owner, exactly as for every ticket.
#  2. WAIT until the ticket is granted (same reap/pick loop as bb-build's waiter), then print "granted <ticket-id>" to stderr.
#  3. START: run <argv> directly, no shell (in practice "docker run -d --name <name> ..."). Non-zero rc -> release, exit rc.
#  4. HOLD: "docker wait <name>"; when the container exits, release and exit with the container's exit code.
#  5. SIGTERM/SIGINT/SIGHUP: release the ticket and exit 143. The container is NOT touched; the caller owns it.
# Exit codes: the container's / argv's rc; 143 on signal; 2 refused (bad arguments, missing --container, empty argv,
# owner outside [A-Za-z0-9_]+, container name outside docker's [a-zA-Z0-9][a-zA-Z0-9_.-]+); 3 another bb-hold holds the
# same <owner>-<name>; 9 the ticket left the queue while waiting (bb-queue cancel); 1 docker wait itself failed.
# State: ~/work/bb-hold/<owner>-<name>/pid (removed on exit) and state (key=value: ticket, container, started, granted,
# phase=waiting|holding|exited, rc, ended). The ticket's co= is this directory, so bb-queue shows it as the checkout.
# HOW IT FITS bb-queue-lib.sh WITHOUT CHANGING IT (the lib finds liveness and reactors by cmdline):
#  - liveness: this process re-execs itself with "bb-build __run <id>" in its argv, so waiter_alive() sees it, reap()
#    leaves the ticket alone while it lives, and "bb-queue cancel" reaches it (SIGTERM -> release).
#  - reactor count: from grant to release a slot process whose argv carries "classworlds.launcher.Launcher" runs with
#    its cwd in the state dir, so reactors() counts the hold as one reactor. The slot exits within 2 s of this process
#    dying by any means (it polls our pid), after which reap() moves a kill -9'd ticket to done as orphaned.
# Built to run under setsid with no tty: absolute PATH, no reads from stdin. Linux only (flock, /proc), like the lib.
set -u
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin; LC_ALL=C; export PATH LC_ALL
USER=${USER:-$(id -un)}; HOME=${HOME:-$(getent passwd "$USER" | cut -d: -f6)}; export USER HOME
SELF=$(readlink -f "$0")
USAGE="usage: bb-hold <owner> <prio> --container <name> -- <argv...>"
refuse() { echo "$USAGE" >&2; echo "refusing: $1" >&2; exit 2; }

if [ "${BB_HOLD_EXEC:-}" != "$$" ]; then
  # ---- front: validate, then re-exec under the marker argv (same pid, so a caller's $! stays valid) ----
  [ $# -ge 2 ] || refuse "missing <owner> and/or <prio>"
  OWNER=$1; PRIO_ARG=$2; shift 2
  case "$OWNER" in ''|*[!A-Za-z0-9_]*) refuse "owner '$OWNER' must match [A-Za-z0-9_]+";; esac
  case "$PRIO_ARG" in ''|-|*[!0-9-]*|?*-*) refuse "prio '$PRIO_ARG' must be an integer";; esac
  NAME=""; DD=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --container) [ $# -ge 2 ] || refuse "--container needs a value"; NAME=$2; shift 2;;
      --) shift; DD=1; break;;
      *) refuse "unexpected argument '$1' (argv goes after --)";;
    esac
  done
  [ -n "$NAME" ] || refuse "missing --container <name>"
  case "$NAME" in [a-zA-Z0-9]?*) ;; *) refuse "container name '$NAME' must match [a-zA-Z0-9][a-zA-Z0-9_.-]+";; esac
  case "$NAME" in *[!a-zA-Z0-9_.-]*) refuse "container name '$NAME' must match [a-zA-Z0-9][a-zA-Z0-9_.-]+";; esac
  [ "$DD" = 1 ] || refuse "missing -- before argv"
  [ $# -gt 0 ] || refuse "empty argv after --"
  ID=$(date +%s%N)-$$
  BB_HOLD_EXEC=$$ exec "$BASH" "$SELF" __hold "$OWNER" "$PRIO_ARG" "$NAME" bb-build __run "$ID" -- "$@"
fi

# ---- holder: argv is __hold <owner> <prio> <name> bb-build __run <id> -- <argv...> ----
unset BB_HOLD_EXEC
OWNER=$2; PRIO_ARG=$3; NAME=$4; ID=$7; shift 8
. "$(dirname "$SELF")/bb-queue-lib.sh"
CAP=5
D=$HOME/work/bb-hold/$OWNER-$NAME
mkdir -p "$D"
exec 7> "$D/.lock"
flock -n 7 || { echo "refusing: another bb-hold holds $D (pid $(cat "$D/pid" 2>/dev/null))" >&2; exit 3; }
echo $$ > "$D/pid"
STARTED=$(date +%s); GRANTED=""; PHASE=waiting; RC=""; ENDED=""
SLOT=""; CHILD=""; T=$Q/waiting/$ID
write_state() {
  printf 'pid=%s\nowner=%s\ncontainer=%s\nticket=%s\nrequested_prio=%s\nstarted=%s\ngranted=%s\nphase=%s\nrc=%s\nended=%s\n' \
    "$$" "$OWNER" "$NAME" "$ID" "$PRIO_ARG" "$STARTED" "$GRANTED" "$PHASE" "$RC" "$ENDED" > "$D/state.tmp"
  mv -f "$D/state.tmp" "$D/state"
}
# release <state> <rc>: under the queue lock, stop the reactor slot, then move the ticket to done/. Idempotent.
release() {
  trap '' TERM INT HUP
  flock 8
  [ -n "$SLOT" ] && { kill -KILL "$SLOT" 2>/dev/null; wait "$SLOT" 2>/dev/null; SLOT=""; }
  if [ -f "$Q/running/$ID" ]; then
    printf 'state=%s\nrc=%s\nended=%s\n' "$1" "$2" "$(date +%s)" >> "$Q/running/$ID"; to_done "$Q/running/$ID"
  elif [ -f "$Q/waiting/$ID" ]; then
    printf 'state=cancelled\nended=%s\n' "$(date +%s)" >> "$Q/waiting/$ID"; to_done "$Q/waiting/$ID"
  fi
  flock -u 8
}
finish() { RC=$1; ENDED=$(date +%s); PHASE=exited; write_state; rm -f "$D/pid"; exit "$1"; }
# the caller owns the container: only our own helper child (sleep / docker wait) is stopped; a still-running argv
# (e.g. "docker run -d" mid-pull) and the container itself are left alone
on_signal() {
  [ -n "$CHILD" ] && kill "$CHILD" 2>/dev/null
  release released 143
  echo "bb-hold: signal: released ticket $ID; container $NAME left running" >&2
  finish 143
}
write_state
exec 8> "$Q/.lock"
trap on_signal TERM INT HUP
trap '' PIPE   # a dropped ssh pipe on stderr must not kill the holder mid-hold; writes just fail

flock 8
reap
{ printf 'id=%s\nowner=%s\nco=%s\nsha=%s\nkey=%s\ncap=%s\nlimit=%s\ncreated=%s\n' "$ID" "$OWNER" "$D" "" "" "$CAP" 0 "$(date +%s%N)"
  printf 'group=1\ngroup_reason=bb-hold: container %s holds the port group\n' "$NAME"
  printf 'kind=bb-hold\nrequested_prio=%s\ncontainer=%s\n' "$PRIO_ARG" "$NAME"
  printf 'args=bb-hold --container %s -- ' "$NAME"; printf '%q ' "$@"; printf '\n'; } > "$T"
flock -u 8
echo "bb-hold: queued ticket $ID owner=$OWNER priority=$(prio "$OWNER" "") (requested $PRIO_ARG, advisory) port-group=1" >&2

WAITED=0
while :; do
  flock 8
  [ -f "$T" ] || { flock -u 8; echo "bb-hold: ticket $ID left the queue while waiting ($(field "$Q/done/$ID" state))" >&2; finish 9; }
  reap
  [ "$(pick)" = "$ID" ] && break
  flock -u 8
  sleep 5 8>&- 7>&- & CHILD=$!; wait "$CHILD"; CHILD=""; WAITED=$((WAITED + 5))
done
# granted (lock held): move to running/ and keep the lock until the slot is visible, so the next grant counts it
GRANTED=$(date +%s)
printf 'started=%s\nwaited=%s\n' "$GRANTED" "$WAITED" >> "$T"; mv "$T" "$Q/running/$ID"; T=$Q/running/$ID
( cd "$D" && exec bash -c 'while kill -0 "$1" 2>/dev/null; do sleep 2; done' "bb-hold-slot:classworlds.launcher.Launcher:$ID" "$$" ) < /dev/null > /dev/null 2>&1 8>&- 7>&- &
SLOT=$!
for _ in $(seq 50); do pgrep -u "$USER" -f "bb-hold-slot:[c]lassworlds.launcher.Launcher:$ID" > /dev/null && break; sleep 0.1; done
flock -u 8
PHASE=holding; write_state
echo "granted $ID" >&2

"$@" < /dev/null 8>&- 7>&- & wait $!; ARC=$?
if [ "$ARC" != 0 ]; then
  echo "bb-hold: argv exited $ARC; released ticket $ID" >&2
  release start-failed "$ARC"; finish "$ARC"
fi
docker wait "$NAME" < /dev/null > "$D/wait.out" 2> "$D/wait.err" 8>&- 7>&- & CHILD=$!; wait "$CHILD"; WRC=$?; CHILD=""
CRC=$(head -1 "$D/wait.out" 2>/dev/null)
if [ "$WRC" = 0 ] && [ -n "$CRC" ] && [ -z "${CRC//[0-9]/}" ]; then release finished "$CRC"; finish "$CRC"; fi
echo "bb-hold: docker wait $NAME failed (rc $WRC): $(head -c 300 "$D/wait.err" 2>/dev/null)" >&2
release wait-failed 1; finish 1
