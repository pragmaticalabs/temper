#!/usr/bin/env python3
"""build-lock -- the tree's build lock, as ops/dev/build takes, extends and releases it.

Usage: ops/dev/build-lock take <lock> <pid>              take it for the wrapper <pid>, or exit 3 naming a live holder
       ops/dev/build-lock add <lock> <owner> <pid>       record <pid> (maven's) in <owner>'s lock, or exit 3
       ops/dev/build-lock release <lock> <pid>           remove it if <pid> holds it (its `pid` file's first line)

The lock is the directory <lock> (the contract shared with the tree preflight and prune):
  pid      one integer per line: the wrapper's pid first, maven's second
  lstart   one start time per line, in the order of `pid`, as `ps -o lstart=` prints it under LC_ALL=C TZ=UTC
  info     start and args (optional)
It is held while ANY listed pid is alive by kill(pid, 0) (EPERM: alive), unless `lstart` records a different start time
for it than `ps` reports now: then the pid was reused by another process and does not count. A start time that is not
known (no lstart line, an empty or malformed one, or `ps` failing now) cannot tell reuse apart: the pid holds the lock. A lock directory without a usable pid (an older version still
writing it) is held while the directory is younger than GRACE seconds, and stale after.

Every take, add and release runs under an flock(2) on <lock's dir>/build.guard, which the kernel drops when its holder
dies: only the one process inside the guard decides a lock is stale and removes it; the new lock is built complete in
a unique directory and renamed onto <lock>, which fails rather than nests if <lock> exists again (exit 3). So a lock
made by this script never exists without its pids, two takeovers cannot both succeed, and no lock lands inside another.
Exit codes: 0 done, 3 held by another run, or the race for it lost (take), or no longer this owner's (add).
"""
import fcntl
import os
import re
import shutil
import subprocess
import sys
import time

GRACE = 10
LSTART = re.compile(r"^[A-Z][a-z]{2} [A-Z][a-z]{2} [0-9]{1,2} [0-9]{2}:[0-9]{2}:[0-9]{2} [0-9]{4}$")


def alive(pid):
    """kill(pid, 0): no such process is dead; EPERM is another user's live process. Never ps, which can fail."""
    try:
        os.kill(int(pid), 0)
        return True
    except PermissionError:
        return True
    except (OSError, ValueError, OverflowError):
        return False


def started(pid):
    """The pid's start time, or None when no process has it."""
    env = dict(os.environ, LC_ALL="C", TZ="UTC")
    result = subprocess.run(["ps", "-o", "lstart=", "-p", str(pid)], stdout=subprocess.PIPE,
                            stderr=subprocess.DEVNULL, universal_newlines=True, env=env)
    text = " ".join(result.stdout.split())
    return text if result.returncode == 0 and text else None


def lines(path):
    try:
        with open(path, encoding="utf-8", errors="replace", newline="") as source:  # newline="": a CR stays a CR
            return source.read().split("\n")  # lines as awk and sed -n see them, blanks and CR kept
    except OSError:
        return []


def is_pid(line):
    """A bare pid > 0, as lib.sh's /^[0-9]+$/: a blank, a CR or any script's digits besides ASCII make it no pid."""
    return line.isascii() and line.isdigit() and int(line) > 0


def pids(lock):
    return [line for line in lines(os.path.join(lock, "pid")) if is_pid(line)]


def starts(lock):
    """pid -> recorded start time, line for line of `pid` and `lstart` (as ops/dev/lib.sh reads them)."""
    return dict((pid, " ".join(start.split())) for pid, start in zip(lines(os.path.join(lock, "pid")),
                                                                    lines(os.path.join(lock, "lstart")))
                if is_pid(pid) and LSTART.match(" ".join(start.split())))  # anything else: start unknown


def holders(lock):
    """(live: [description], dead: [description]) of the processes the lock names."""
    listed = pids(lock)
    if not listed:
        try:
            age = time.time() - os.stat(lock).st_mtime
        except OSError:
            return [], ["pid none"]
        if age < GRACE:
            return ["no pid yet (being taken %d s ago)" % age], []
        return [], ["pid none"]
    recorded = starts(lock)
    live, dead = [], []
    for index, pid in enumerate(listed):
        role = ("wrapper", "maven")[index] if index < 2 and pid in recorded else None
        if not alive(pid):
            dead.append("pid %s%s" % (pid, " (%s)" % role if role else ""))
            continue
        now = started(pid)  # None when ps fails: the start is unknown, and the lock is held (fails closed)
        if now is None or pid not in recorded or recorded[pid] == now:
            live.append("pid %s%s%s" % (pid, " (%s)" % role if role else "", "" if now else " (start unknown)"))
        else:
            dead.append("pid %s (%s, reused: started %s, recorded %s)" % (pid, role, now, recorded[pid]))
    return live, dead


def about(lock):
    return " ".join(" ".join(lines(os.path.join(lock, "info"))).split())


def write(directory, name, content):
    path = os.path.join(directory, name)
    with open(path + ".tmp", "w", encoding="utf-8") as out:
        out.write(content)
    os.rename(path + ".tmp", path)


def lost(lock, why):
    print("refused: %s %s; run again" % (lock, why), file=sys.stderr)
    sys.exit(3)


def take(lock, pid):
    if os.path.isdir(lock):
        live, dead = holders(lock)
        if live:
            print("refused: %s is held by %s (%s); wait for it, or remove %s if no build runs"
                  % (lock, ", ".join(live), about(lock), lock), file=sys.stderr)
            sys.exit(3)
        print("taking over %s: %s not running (%s)"
              % (lock, ", ".join(d + " is" for d in dead), about(lock)), file=sys.stderr)
        shutil.rmtree(lock, ignore_errors=True)
    pause = os.environ.get("BUILD_LOCK_TEST_PAUSE")  # test seam: widens the window between the check and the rename
    if pause:
        time.sleep(float(pause))
    fresh = os.path.join(os.path.dirname(lock), "build.new-%s" % pid)
    shutil.rmtree(fresh, ignore_errors=True)
    try:
        os.mkdir(fresh)
        write(fresh, "lstart", "%s\n" % (started(pid) or ""))  # an empty line: start unknown, never "None"
        write(fresh, "pid", "%s\n" % pid)
        os.rename(fresh, lock)  # a directory onto an existing, non-empty one fails: it never nests
    except OSError as cause:
        shutil.rmtree(fresh, ignore_errors=True)
        lost(lock, "was taken by another build during the takeover (%s)" % cause.strerror)


def add(lock, owner, pid):
    listed = pids(lock)
    if listed[:1] != [owner]:
        lost(lock, "is no longer held by pid %s" % owner)
    recorded = lines(os.path.join(lock, "lstart"))[:len(listed)]
    write(lock, "lstart", "".join("%s\n" % start for start in recorded + [started(pid) or ""]))  # first: never a pid without it
    write(lock, "pid", "".join("%s\n" % p for p in listed + [pid]))


def release(lock, pid):
    if pids(lock)[:1] == [pid]:
        shutil.rmtree(lock, ignore_errors=True)


def main():
    command, lock, rest = sys.argv[1], sys.argv[2], sys.argv[3:]
    with open(os.path.join(os.path.dirname(lock), "build.guard"), "a") as guard:
        fcntl.flock(guard, fcntl.LOCK_EX)
        if command == "take":
            take(lock, *rest)
        elif command == "add":
            add(lock, *rest)
        elif command == "release":
            release(lock, *rest)
        else:
            sys.exit(2)


if __name__ == "__main__":
    main()
