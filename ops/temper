#!/bin/sh
# temper CLI wrapper (m0-design §1.3, §8); install as ~/.local/bin/temper on the Mac.
#
#   install: mkdir -p ~/.local/lib/temper ~/.local/bin
#            cp temper-cli/target/temper-cli-<ver>.jar ~/.local/lib/temper/temper-cli.jar
#            cp ops/temper ~/.local/bin/temper && chmod 755 ~/.local/bin/temper
#
# Overrides: TEMPER_CLI_JAR (jar path), TEMPER_JAVA (java executable; else $JAVA_HOME/bin/java, else java).
#
# Exit codes are the CLI's contract (spec §8.1): 1 means FAILED. A launcher problem must therefore never
# surface as the JVM's own exit 1, so a missing jar or java is reported here as 64 (usage/configuration).
# A JVM older than 25 fails class loading with exit 1; JAVA_HOME/TEMPER_JAVA must point at Java 25+.
set -eu

jar="${TEMPER_CLI_JAR:-$HOME/.local/lib/temper/temper-cli.jar}"
if [ -n "${TEMPER_JAVA:-}" ]; then
    java="$TEMPER_JAVA"
elif [ -n "${JAVA_HOME:-}" ]; then
    java="$JAVA_HOME/bin/java"
else
    java="java"
fi

if [ ! -r "$jar" ]; then
    echo "temper: CLI jar not found: $jar (set TEMPER_CLI_JAR or install it there)" >&2
    exit 64
fi
if ! command -v "$java" >/dev/null 2>&1; then
    echo "temper: java not found: $java (set TEMPER_JAVA or JAVA_HOME to a Java 25+ runtime)" >&2
    exit 64
fi

# Short-lived process: no JIT warm-up worth paying for. -Xmx256m is a ceiling, not a reservation: alarm-check's worst-case
# GitHub pages need it (arithmetic in ops/temper-alarm.service).
exec "$java" -XX:TieredStopAtLevel=1 -XX:+UseSerialGC -Xmx256m -jar "$jar" "$@"
