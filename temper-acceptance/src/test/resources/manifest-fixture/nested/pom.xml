<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>fx</groupId>
        <artifactId>manifest-fixture</artifactId>
        <version>1</version>
    </parent>
    <artifactId>nested</artifactId>
    <!-- Default surefire config. Its test-jar carries the R-6 bases (archive fixture6 module a) for module inherit. -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
