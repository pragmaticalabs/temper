<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.pragmatica.temper</groupId>
        <artifactId>temper-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <!-- The deployment artifacts of ONE build (m0-design §12.7 item 3): the controller, worker and cli fat jars are
         copied to target/dist at `package`, and DistJarsIT (failsafe, `integration-test`) proves from the jar files
         themselves that the controller's expected worker version and the worker's own version are this build's
         ${project.version}. The three jars are dependencies only for reactor order and resolution; they are kept off
         the test classpath, so the IT reads them as files, exactly as a deploy would. -->
    <artifactId>temper-dist</artifactId>
    <name>temper dist</name>

    <dependencies>
        <dependency>
            <groupId>org.pragmatica.temper</groupId>
            <artifactId>temper-test-support</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.pragmatica.temper</groupId>
            <artifactId>temper-controller</artifactId>
            <version>${project.version}</version>
            <classifier>all</classifier>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.pragmatica.temper</groupId>
            <artifactId>temper-worker</artifactId>
            <version>${project.version}</version>
            <classifier>all</classifier>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.pragmatica.temper</groupId>
            <artifactId>temper-cli</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.10.0</version>
                <executions>
                    <execution>
                        <id>dist-jars</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeGroupIds>org.pragmatica.temper</includeGroupIds>
                            <includeArtifactIds>temper-controller,temper-worker,temper-cli</includeArtifactIds>
                            <excludeTransitive>true</excludeTransitive>
                            <outputDirectory>${project.build.directory}/dist</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <classpathDependencyExcludes>
                        <classpathDependencyExclude>org.pragmatica.temper:temper-controller</classpathDependencyExclude>
                        <classpathDependencyExclude>org.pragmatica.temper:temper-worker</classpathDependencyExclude>
                        <classpathDependencyExclude>org.pragmatica.temper:temper-cli</classpathDependencyExclude>
                    </classpathDependencyExcludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.4</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <classpathDependencyExcludes>
                        <classpathDependencyExclude>org.pragmatica.temper:temper-controller</classpathDependencyExclude>
                        <classpathDependencyExclude>org.pragmatica.temper:temper-worker</classpathDependencyExclude>
                        <classpathDependencyExclude>org.pragmatica.temper:temper-cli</classpathDependencyExclude>
                    </classpathDependencyExcludes>
                    <!-- The JVM that runs the ITs carries poisoned host variables, so a child that inherits the environment
                         shows it (BbFixturesRunIT); every launch goes through HermeticProcess and strips them. -->
                    <environmentVariables>
                        <BB_HOST>cloudbb-d1</BB_HOST>
                        <SSH_AUTH_SOCK>/poison/agent</SSH_AUTH_SOCK>
                    </environmentVariables>
                    <systemPropertyVariables>
                        <project.version>${project.version}</project.version>
                        <dist.dir>${project.build.directory}/dist</dist.dir>
                        <temper.judge>${temper.judge}</temper.judge>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
