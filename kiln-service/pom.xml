<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.pragmatica.temper</groupId>
        <artifactId>temper-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <!-- kiln's process (kiln-f1-design §1.2): config, kiln-pg store, the GitHub/temper/mirror/scan adapters, the
         pollers, the loopback HTTP server and Main. -->
    <artifactId>kiln-service</artifactId>
    <name>kiln service</name>

    <dependencies>
        <dependency>
            <groupId>org.pragmatica.temper</groupId>
            <artifactId>temper-test-support</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.pragmatica.temper</groupId>
            <artifactId>kiln-core</artifactId>
        </dependency>
        <!-- Q-9 (ruled): temper-protocol for `protocol.exec` only (ProcessRunner, Command, Completed). temper-domain is
             excluded, since exec imports none of it, so no temper domain type can reach kiln. NoTemperJsonTest keeps
             `protocol.json` and temper-store out of kiln's sources. -->
        <dependency>
            <groupId>org.pragmatica.temper</groupId>
            <artifactId>github-app-auth</artifactId>
        </dependency>
        <dependency>
            <groupId>org.pragmatica.temper</groupId>
            <artifactId>temper-protocol</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.pragmatica.temper</groupId>
                    <artifactId>temper-domain</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.pragmatica-lite</groupId>
            <artifactId>core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.pragmatica-lite</groupId>
            <artifactId>toml</artifactId>
        </dependency>
        <dependency>
            <groupId>org.pragmatica-lite</groupId>
            <artifactId>jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.pragmatica-lite</groupId>
            <artifactId>postgres-async</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- Only the version file is filtered, as temper-controller's: the judge is the bb build's ${temper.judge};
                 the migrations and logback.xml are never filtered. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>org/pragmatica/kiln/service/kiln-version.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>org/pragmatica/kiln/service/kiln-version.properties</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- it-pg tier (temper-store's, m0-design §9): the *IT classes need docker for postgres:16 and run
                         in the default build; without docker they are skipped, not passed. -->
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!-- Attached as `-all` (the deployed, runnable jar), never replacing the main jar, as
                                 temper-controller does: the main jar stays this module's classes only. Main arrives
                                 with WP9 (kiln-f1-design §7.1). -->
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>all</shadedClassifierName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.pragmatica.kiln.service.Main</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
